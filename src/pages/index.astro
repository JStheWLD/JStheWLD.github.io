---
import Base from '../layouts/Base.astro';
import Texture from '../components/Texture.astro';
import Well from '../components/Well.astro';
import Noise from '../components/Noise.astro';
import Harp from '../components/Harp.astro';
import Spine from '../components/Spine.astro';
import Strings from '../components/Strings.astro';
import Mark from '../components/Mark.astro';
import Tilt from '../components/Tilt.astro';
import Layers from '../components/Layers.astro';
import { STORM_DOOR_URL } from '../consts';
---
<Base title="JS the WLD — Jonathan Sexton" nav="none" bare={true} motion={true}>
  <!-- ── HUD chrome: seal + corner consoles ── -->
  <a class="seal" href="/" aria-label="JS the WLD, home">
    <img src="/assets/bird-white.png" alt="" width="18" height="18" />
  </a>
  <div class="hud hud--bl" aria-hidden="true"><span data-hud>Words / Music / Code</span></div>
  <div class="hud hud--br" aria-hidden="true"><span data-pct>00</span></div>
  <Spine stops={["Words", "Code", "Music", "Jonathan", "The Storm Door"]} />
  <Harp />
  <Tilt />

  <main id="top">
    <!-- ══ 01 HERO — the ground falls away ══ -->
    <section class="hero" aria-label="JS the WLD">
      <Well />
      <Texture tone="dark" />

      <div class="hero__body">
        <!-- the mark in three pieces, cut at the seams where JS / THE / WLD
             interlock, so it can come apart and turn as you scroll -->
        <Mark />

        <p class="hero__name"><span class="rv">Hi, I'm Jonathan. AKA, JS the WLD.</span></p>

        <p class="hero__line"><span class="rv rv--2">I make stories with Words, Music, Code.</span></p>
      </div>

      <a class="cue" href="#words" aria-label="Start"><span aria-hidden="true"></span></a>
    </section>

    <!-- ══ 02 THE WORD ON HIM — its own room, so it is not a footnote ══ -->
    <section class="say" aria-label="Praise">
      <Texture tone="dark" />
      <blockquote class="say__quote">
        <p>&ldquo;JS the WLD is the real deal. An authentic, refreshing Southern voice.&rdquo;</p>
        <cite>Kathryn Aalto, New York Times bestselling author</cite>
      </blockquote>
    </section>

    <!-- ══ 03–05 THE TRIPTYCH — the three crafts run left to right ══ -->
    <section class="tri" id="words" data-tri aria-label="Words, Code and Music">
      <div class="tri__spring" data-tri-spring>
      <div class="tri__rail" data-tri-rail>

        <!-- WORDS -->
        <article class="panel panel--paper" id="code-anchor-words" data-hud="Words">
          <Texture tone="light" />
          <Noise tone="#C1512A" seed={1337} scale={0.055} speed={0.06} strength={0.42} blend="multiply" />
          <h2 class="panel__word panel__word--chroma" aria-hidden="true"><span data-t="WORDS">WORDS</span></h2>
          <div class="panel__body">
            <figure class="panel__fig" data-tilt>
              <img src="/assets/portrait.jpg" alt="Jonathan Sexton seated on a red couch, a lamp glowing beside him." width="600" height="900" loading="lazy" />
            </figure>
            <div class="panel__tell">
              <p class="tag">01 &mdash; The thread between old and new</p>
              <p>I write about music, technology, culture, and the South. The unexpected ways they show up in our lives, how that shapes something else, that shapes something else&hellip; turtles all the way down.</p>
              <p>You can find my work in places like MTV.com and Substack.</p>
              <div class="panel__links">
                <a class="lnk" href={STORM_DOOR_URL} rel="noopener">Read my Substack</a>
              </div>
            </div>
          </div>
        </article>

        <!-- CODE -->
        <article class="panel panel--wire" data-hud="Code">
          <div class="wire" aria-hidden="true"><span></span><span></span><span></span></div>
          <Texture tone="dark" />
          <Noise tone="#40C4E8" seed={7717} scale={0.16} speed={0.22} strength={0.5} blend="screen" />
          <h2 class="panel__word panel__word--lit panel__word--scramble" aria-hidden="true"><span data-final="CODE">CODE</span></h2>
          <div class="panel__body">
            <figure class="panel__fig is-wide" data-layers>
              <img src="/assets/billy-bob-lightform.png" alt="Billy Bob, the light form — 302 nodes and 380 threads of American music history rendered as a constellation." width="1269" height="777" loading="lazy" />
              <Layers />
            </figure>
            <div class="panel__tell">
              <p class="tag tag--lit">02 &mdash; Generative Art</p>
              <p>I make digital installations that trace influence over time.</p>
              <p>The newest piece is <em>The Lomax Trail</em>: a hundred and fifty years of American song drawn off of one trailhead, where almost everything you hear flows back up to a Lomax field recording.</p>
              <div class="panel__links">
                <a class="lnk lnk--lit" href="/field/lomax/">Open the river</a>
              </div>
            </div>
          </div>
        </article>

        <!-- MUSIC -->
        <article class="panel panel--dusk" data-hud="Music">
          <Texture tone="dark" />
          <Noise tone="#D99A42" seed={4242} scale={0.07} speed={0.1} strength={0.46} blend="screen" />
          <Strings />
          <h2 class="panel__word panel__word--anaglyph" aria-hidden="true"><span data-t="MUSIC">MUSIC</span></h2>
          <div class="panel__body">
            <figure class="panel__fig">
              <img src="/assets/interstitial.jpg" alt="" aria-hidden="true" width="600" height="900" loading="lazy" />
            </figure>
            <div class="panel__tell">
              <p class="tag">03 &mdash; Performing Artist</p>
              <blockquote class="pull pull--amber">
                <p>&ldquo;Imagine Little Feat and Bleachers made a record together. That's JS the WLD.&rdquo;</p>
              </blockquote>
              <p>New EP <em>Long Way to Run</em>, produced by Cruz Contreras, out in 2027 on Baked Alaska Records.</p>
              <div class="panel__links">
                <a class="lnk lnk--amber" href="https://www.youtube.com/watch?v=M_LTKnkf4b4" rel="noopener">Listen to the band</a>
              </div>
            </div>
          </div>
        </article>


        <!-- BOOK -->
        <article class="panel panel--book" data-hud="The Book">
          <Noise tone="#C1512A" seed={9091} scale={0.045} speed={0.045} strength={0.5} blend="multiply" />
          <h2 class="panel__word" aria-hidden="true"><span>THE BOOK</span></h2>
          {/* No figure here on purpose. The stand-in was the Storm Door cover
              banner, which is the letter's masthead and carries its wordmark —
              wrong thing entirely on a panel about the book. There is no unused
              photograph in the repo to replace it with: the only three
              (hero, portrait, interstitial) are already carrying About, Words
              and Music. Runs full width until the book has an image of its own,
              which is how this panel read before. */}
          <div class="panel__body panel__body--wide">
            <div class="panel__tell">
              <p class="tag">04 &mdash; Years in the making</p>
              <p><em>The Sound of Something More</em> is the premier literary work from JS the WLD, who with high wit and wisdom likens the ineffable nature of song to the sacred power felt in dreams or prayer.</p>
              <p>It weaves personal narrative, cultural history, and philosophical inquiry to explore music as a force that shapes who we are, and the patterns that ripple across generations.</p>
              <p>Technology runs through it as a character rather than a subject: every machine that ever caught a song changed what a song could be.</p>
              <div class="panel__links">
                <a class="lnk" href="/book">About the book</a>
              </div>
            </div>
          </div>
        </article>

      </div>
      </div>
    </section>

    <!-- ══ 05 JONATHAN ══ -->
    <section class="act act--paper" id="jonathan" data-hud="Jonathan" aria-label="Jonathan Sexton">
      <Texture tone="light" />
      <h2 class="act__word act__word--r" aria-hidden="true"><span>SOUTH</span></h2>
      <div class="stage" data-stage>
        <figure class="grow grow--d">
          <img src="/assets/hero.jpg" alt="Jonathan Sexton at a wood-paneled bar in warm lamplight." width="600" height="900" loading="lazy" />
        </figure>
        <div class="tell">
          <p class="tag">05 &mdash; About JS the WLD</p>
          <h3>In a world of ones and zeros, we still need three chords and the truth.</h3>
          <p>I live in Nashville, but I grew up in the same East Tennessee mountains that gave us Dolly Parton.</p>
          <p>I'm an endless creative who had to learn a lot of ways to keep food on the table. Public school teacher, touring musician, award-winning software entrepreneur, blockchain and AI expert. Along the way I picked up an MTV O Music Award, a Guinness World Record, and a Napster download history I still won't own up to.</p>
          <p>I'm obsessed with carrying the best of our old ways into the best of the new ones, without losing what makes us human.</p>
          <a class="lnk" href="/about">More about Jonathan</a>
        </div>
      </div>
    </section>

    <!-- ══ 06 CLOSE — arrives from the right, the last turn ══ -->
    <div class="endwrap" data-endwrap>
    <section class="end" id="the-storm-door" data-hud="The Storm Door" aria-label="Subscribe">
      <Well variant="bed" />
      <Texture tone="dark" />
      <div class="end__body" data-stage>
        <figure class="grow grow--e end__art is-wide">
          <img src="/assets/storm-door/cover-banner-storm.jpg" alt="The Storm Door" width="1200" height="450" loading="lazy" />
        </figure>
        <p class="tag tag--lit">Most Saturdays</p>
        <h2 class="end__word">THE STORM DOOR</h2>
        <p class="end__copy">Free, and short enough for one cup of coffee. Leave your name and I'll meet you there Saturday.</p>
        <a class="cta" href={STORM_DOOR_URL} rel="noopener">Read the letter</a>
      </div>
      <p class="colophon">JS the WLD &mdash; the pen name of Jonathan Sexton &mdash; East Tennessee, by way of Nashville</p>
    </section>
    </div>
  </main>

  <script>
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // hero failsafe — animations throttle in hidden tabs; never ship a blank hero
    const hero = document.querySelector('.hero');
    const settle = () => hero && hero.classList.add('set');
    if (reduce) settle();
    else {
      setTimeout(settle, 3400);
      document.addEventListener('visibilitychange', () => { if (document.hidden) settle(); });
    }

    // ── LAZY LOADING CANNOT SEE INSIDE A PINNED RAIL ────────────────────────
    // Three of the four panels sit at grid positions outside the viewport and
    // are brought in by a transform on the rail, not by the document scrolling
    // them into view. The browser's lazy heuristic therefore decides they are
    // permanently off screen and never fetches them. Measured: walking the
    // entire pinned section start to finish loaded NONE of the photographs.
    //
    // It is not only the rail. The close is absolutely positioned and slid in,
    // and every .grow figure sits under its own translateZ(-520px) until it is
    // revealed — the About portrait failed to load even with the section
    // scrolled fully into view. ANY transformed ancestor defeats the heuristic,
    // so the sweep covers every lazy image in main rather than guessing which
    // containers move. There are five; the cost of being right is nothing.
    //
    // So they are promoted to eager once the hero has had its moment: on the
    // reader's first scroll, or shortly after load, whichever comes first.
    // Reassigning src is what actually starts the fetch; flipping the attribute
    // alone does not re-run the decision on an image the parser already saw.
    let lifted = false;
    const lift = () => {
      if (lifted) return;
      lifted = true;
      removeEventListener('scroll', lift);
      removeEventListener('wheel', lift);
      removeEventListener('touchstart', lift);
      document.querySelectorAll('main img[loading="lazy"]')
        .forEach((im) => { im.loading = 'eager'; if (!im.complete) im.src = im.src; });
    };
    addEventListener('scroll', lift, { passive: true });
    addEventListener('wheel', lift, { passive: true });
    addEventListener('touchstart', lift, { passive: true });
    setTimeout(lift, 1800);

    // ── Scroll-linked arrivals ──────────────────────────────────────────────
    // Every element carries `.in` as its END state. Under reduced motion (or if
    // the motion stack never boots) we simply add it and stop — the page is
    // fully composed with no tween ever registered. Otherwise ScrollTrigger
    // scrubs each element from its start transform to that end state, so motion
    // tracks the wheel in both directions instead of firing once and forgetting.
    const risers = [...document.querySelectorAll('[data-stage] > *, .act__word')];

    const composeStatically = () => risers.forEach((el) => el.classList.add('in'));

    const wireScrubbed = ({ gsap, ScrollTrigger, lenis }) => {
      // `.in` is applied up front so the element's *final* layout is what CSS
      // describes; GSAP then owns the transform/opacity between start and end.
      composeStatically();

      // Start transforms mirror the CSS intent, expressed as GSAP values so one
      // system owns the property. The CSS transition rules are gone (see <style>).
      const startFor = (el) => {
        if (el.classList.contains('slide')) {
          const far = el.classList.contains('slide--far');
          const dx = (el.classList.contains('slide--l') ? -1 : 1) * (far ? 160 : 90);
          return { x: dx, rotation: (dx < 0 ? -1 : 1) * (far ? 5 : 4), scale: far ? 0.92 : 1, opacity: 0 };
        }
        if (el.classList.contains('grow')) {
          const deep = el.classList.contains('grow--f');
          return { z: deep ? -780 : -520, scale: deep ? 0.3 : 0.42, opacity: 0 };
        }
        if (el.classList.contains('shout')) return { z: -420, opacity: 0 };
        if (el.classList.contains('act__word')) {
          const dir = el.classList.contains('act__word--r') ? 1 : -1;
          return { xPercent: 26 * dir, opacity: 0 };
        }
        return { y: 28, opacity: 0 }; // .tell and anything else in a stage
      };

      // ── Per-act signatures ──────────────────────────────────────────────
      // Each act gets its own window and scrub weight so the page reads as a
      // composed sequence rather than the same reveal five times. Heavier scrub
      // = more lag behind the wheel = a slower, weightier arrival.
      // Windows end high on the screen so a section is COMPOSED by the time the
      // reader reaches it. The previous ends — 46% and 56% — meant content was
      // still arriving while it was already being read.
      const SIGNATURES = [
        ['act--paper', { start: 'top 99%', end: 'top 70%', scrub: 0.9 }], // lateral, unhurried
        ['end', { start: 'top 99%', end: 'top 74%', scrub: 1.1 }], // settles
      ];
      const signatureFor = (el) => {
        for (const [cls, sig] of SIGNATURES) if (el.closest('.' + cls)) return sig;
        return { start: 'top 96%', end: 'top 68%', scrub: 0.6 };
      };


      const generic = risers;

      generic.forEach((el) => {
        // act words animate their inner span so the clipping wrapper stays put
        const node = el.classList.contains('act__word') ? el.querySelector('span') || el : el;
        const end = el.classList.contains('act__word')
          ? { xPercent: 0, opacity: 0.13 }
          : { x: 0, y: 0, z: 0, xPercent: 0, rotation: 0, scale: 1, opacity: 1 };
        const sig = signatureFor(el);

        gsap.fromTo(node, startFor(el), {
          ...end,
          ease: 'none',
          scrollTrigger: { trigger: el, start: sig.start, end: sig.end, scrub: sig.scrub },
        });
      });

      // ── Signature motions ───────────────────────────────────────────────
      // Each keys off what the thing *is*, rather than being another entrance.

      // 1. UNMASK. Photographs wipe open from their own frame instead of fading,
      //    so the plate reads as a shutter rather than a container.
      document.querySelectorAll('.stage figure img, .panel__fig img, .panel__fig .layers__gl').forEach((img) => {
        gsap.fromTo(img,
          { clipPath: 'inset(0% 0% 100% 0%)' },
          { clipPath: 'inset(0% 0% 0% 0%)', ease: 'none',
            // Ends near the foot of the screen, not halfway up it. At 'top 50%'
            // a photograph was still opening when the reader had already
            // arrived and was looking straight at it.
            scrollTrigger: { trigger: img.closest('figure'), start: 'top 98%', end: 'top 72%', scrub: 0.5 } });
      });

      // 2. COUNTER-DRIFT. Copy rises slightly slower than its own section, so the
      //    two planes separate as you pass — depth from parallax, not shadow.
      document.querySelectorAll('.tell').forEach((tell) => {
        gsap.fromTo(tell, { yPercent: 6 }, { yPercent: -6, ease: 'none',
          scrollTrigger: { trigger: tell.closest('.stage') || tell, start: 'top bottom', end: 'bottom top', scrub: 1.2 } });
      });

      // 3. TRACKING OPEN. The act words widen their letterspacing as they arrive,
      //    so the type breathes instead of just sliding in.
      document.querySelectorAll('.act__word span, .panel__word span').forEach((sp) => {
        gsap.fromTo(sp, { letterSpacing: '-0.09em' }, { letterSpacing: '-0.035em', ease: 'none',
          scrollTrigger: { trigger: sp.closest('.act__word, .panel__word'), start: 'top 92%', end: 'top 45%', scrub: 0.8 } });
      });

      // 4. The seal turns with the page — a real readout of progress, not decor.
      const seal = document.querySelector('.seal img');
      if (seal) {
        gsap.to(seal, { rotation: 360, ease: 'none',
          scrollTrigger: { trigger: document.body, start: 'top top', end: 'bottom bottom', scrub: 1.4 } });
      }


      // ── THE TRIPTYCH: vertical scroll runs the three crafts sideways ─────
      const tri = document.querySelector('[data-tri]');
      const triRail = document.querySelector('[data-tri-rail]');
      // Hoisted: the anaglyph and the CODE scramble below are driven off this
      // rail, and a block-scoped const left both of them referencing an
      // undefined binding — a ReferenceError that aborted wireScrubbed partway
      // through on every single load, taking the scramble, the anaglyph and the
      // final ScrollTrigger.refresh() with it. Null below 700px, where there is
      // no rail at all.
      let triTl = null, triPin = null;
      if (tri && triRail && window.matchMedia('(min-width: 700px)').matches) {
        // THE SERPENTINE. Across the top, down the right, back across the
        // bottom, so the reader turns three corners instead of running one
        // direction for four screens: down, right, down, left, then down and out.
        const stepX = () => window.innerWidth;
        const stepY = () => window.innerHeight;
        const pathLen = () => stepX() * 2 + stepY();

        // Dwell is bought OUTSIDE the path: a pin-only trigger holds the section
        // for a lead-in before anything is allowed to move, so the reader gets
        // most of a viewport of scrolling with WORDS sitting still.
        const LEAD = () => Math.round(window.innerHeight * 0.62);

        const pinTrig = triPin = ScrollTrigger.create({
          trigger: tri,
          start: 'top top',
          end: () => '+=' + (LEAD() + pathLen() * 1.45),
          pin: true,
          invalidateOnRefresh: true,
          anticipatePin: 1,
          refreshPriority: 1,      // must resolve before the path reads its range
        });

        // Three equal legs, so each panel sits at a clean third of the timeline
        // and the panel-window helper below keeps mapping index -> i/3. This can
        // be a multi-leg timeline now only because nothing reads it through
        // containerAnimation any more; that API maps a single linear horizontal
        // tween and cannot survive a path that turns corners.
        triTl = gsap.timeline({
          scrollTrigger: {
            // Absolute scroll positions taken from the pin, NOT a selector-based
            // start: `tri` is pinned, so ScrollTrigger offsets it by the pin
            // spacer and a relative start like 'top top-=LEAD' resolved past the
            // end of the pin — the rail then never moved at all.
            start: () => pinTrig.start + LEAD(),
            end: () => pinTrig.end,
            scrub: 1.1,
            invalidateOnRefresh: true,
            // EACH PANEL LOCKS IN. Three legs carry four panels, so a panel is
            // centred at every third of this timeline. When the reader stops,
            // the rail settles onto the nearest one rather than resting
            // half-way between two, and moving on takes a fresh scroll.
          },
        });
        // ── SNAP, ASKED OF WHOEVER OWNS SCROLL ──────────────────────────
        // ScrollTrigger's own snap writes the scroll position directly, and
        // Lenis overwrites it on its very next frame, so the snap was undone
        // before it could land. Measured: parked halfway between two panels it
        // drifted 232px toward the target and stopped at 0.41 instead of 0.33.
        // Lenis owns scroll here, so the settle has to be asked of Lenis.
        //
        // Fires only once the wheel has actually stopped. Snapping mid-gesture
        // fights the reader for control of their own scroll.
        if (lenis) {
          let idle = 0, landing = false;
          const settle = () => {
            const st = triTl.scrollTrigger;
            if (landing || !st) return;
            const a = st.start, b = st.end, y = lenis.scroll;
            if (y <= a + 1 || y >= b - 1) return;      // outside the rail, leave it alone
            const p = (y - a) / (b - a);
            const target = a + (Math.round(p * 3) / 3) * (b - a);   // four panels, three legs
            if (Math.abs(target - y) < 2) return;                    // already home
            landing = true;
            // Failsafe. If onComplete never arrives — an interrupted scroll, a
            // resize mid-flight — `landing` would stay true and snapping would
            // be dead for the rest of the session with no way back.
            const release = setTimeout(() => { landing = false; }, 900);
            lenis.scrollTo(target, {
              duration: 0.5,
              easing: (t) => 1 - Math.pow(1 - t, 3),
              onComplete: () => { clearTimeout(release); landing = false; },
            });
          };
          lenis.on('scroll', () => {
            if (landing) return;
            clearTimeout(idle);
            idle = setTimeout(settle, 150);
          });
        }

        triTl.to(triRail, { x: () => -stepX(), ease: 'none', duration: 1 })   // right
             .to(triRail, { y: () => -stepY(), ease: 'none', duration: 1 })   // down
             .to(triRail, { x: 0, ease: 'none', duration: 1 });               // left

        // NO RUBBER BAND. There was a two-axis spring here that let the rail
        // run past its position and settle back. It read as bouncy however far
        // it was dialled down, and it actively fights the snap below: a spring
        // and a snap are two different opinions about where the rail should
        // come to rest. The wrapper stays in the markup as the hook, unanimated.
      }


      // ── HERO PARALLAX: depth behind the strands, driven by the same hand
      //    that plays them. Layers shift by different amounts, so the wordmark
      //    sits in front of the field rather than on top of a flat picture.
      const heroEl = document.querySelector('.hero');
      if (heroEl && !reduce) {
        const layers = [
          { el: heroEl.querySelector('.well'), depth: -14 },
          { el: heroEl.querySelector('.tex'), depth: -26 },
          { el: heroEl.querySelector('.hero__body'), depth: 10 },
        ].filter((l) => l.el);
        const qx = layers.map((l) => gsap.quickTo(l.el, 'x', { duration: 0.9, ease: 'power3.out' }));
        const qy = layers.map((l) => gsap.quickTo(l.el, 'y', { duration: 0.9, ease: 'power3.out' }));
        let inHero = false;
        addEventListener('pointermove', (e) => {
          const r = heroEl.getBoundingClientRect();
          inHero = e.clientY >= r.top && e.clientY <= r.bottom;
          if (!inHero) return;
          const nx = (e.clientX - r.left) / r.width - 0.5;
          const ny = (e.clientY - r.top) / r.height - 0.5;
          layers.forEach((l, i) => { qx[i](nx * l.depth); qy[i](ny * l.depth * 0.6); });
        }, { passive: true });
        // ease everything home when the pointer leaves the hero
        addEventListener('pointerleave', () => layers.forEach((l, i) => { qx[i](0); qy[i](0); }), { passive: true });
      }

      // ── THE MARK ────────────────────────────────────────────────────────
      // ONE tween owns these transforms at any moment. The previous version had
      // three: an intro, a scrubbed scroll tween, and an onLeaveBack snap
      // carrying overwrite:'auto'. The snap killed the scrub tween mid-flight
      // while ScrollTrigger still owned it, so the pieces slammed home and then
      // tore apart again — the glitch. The intro also fought the scrub tween for
      // the first two seconds, since the scrub is live from load at progress 0.
      const pieces = [...document.querySelectorAll('.mark__pc')];
      if (pieces.length) {
        // Every shard's escape is its own bearing from the strike point,
        // computed with the fracture at build time and carried on the element.
        // Hard-coded arrays here would silently desynchronise from the geometry
        // the moment the shard count or the seed changed.
        const APART = {
          xPercent:  (i, el) => +el.dataset.dx,
          yPercent:  (i, el) => +el.dataset.dy,
          rotationZ: (i, el) => +el.dataset.rot,
          rotationY: (i, el) => +el.dataset.ry,
          z:         (i, el) => +el.dataset.z,
        };

        // the scroll tween is only created once the intro has finished, so the
        // two never write to the same property in the same frame
        // Guarded: arming is gated on the intro finishing, and GSAP runs on rAF,
        // which browsers freeze in hidden tabs. Without a fallback a page opened
        // in a background tab would never create the scroll tween at all and the
        // mark would sit inert. Same failsafe doctrine as the hero reveal.
        let armed = false;
        const armScroll = () => {
          if (armed) return;
          armed = true;
          off();                       // every arming path drops the listeners
          // If the failsafe fired while the intro was still mid-flight, that
          // tween is still holding the pieces part-way. Retire it and set the
          // assembled state explicitly, so the scroll tween always starts from
          // a known origin rather than wherever the intro happened to stall.
          gsap.killTweensOf(pieces);
          gsap.set(pieces, { yPercent: 0, xPercent: 0, rotationZ: 0, rotationY: 0, z: 0, opacity: 1 });
          gsap.to(pieces, {
            ...APART,
            // power1.out front-loads the travel: the pieces separate as soon as
            // the reader starts scrolling, while the hero is still on screen.
            // The previous power2.in put 75% of the scroll into 14px of movement
            // and saved the real motion for the last quarter — which, against an
            // end of 'bottom top', landed after the hero had already left the
            // viewport. The explosion was running where nobody could see it.
            // Reversed, this same curve is slow-then-fast, so it still arrives
            // home with the click.
            ease: 'power2.out',
            // finish while the hero is still half in frame, not as it exits
            scrollTrigger: { trigger: '.hero', start: 'top top', end: 'bottom center', scrub: 0.6 },
          });
        };

        // Hand over on the reader's first scroll, not just on the intro's clock.
        // Gating purely on onComplete meant anyone who loaded and immediately
        // scrolled — which is most people — got a mark that sat frozen for two
        // seconds and then lurched to catch up. Arming here kills the intro and
        // snaps to assembled first, so the scrub picks up from a known state and
        // its own 0.6s catch-up smooths the handover.
        const handover = () => armScroll();
        const off = () => {
          removeEventListener('wheel', handover);
          removeEventListener('touchmove', handover);
          removeEventListener('keydown', handover);
        };
        addEventListener('wheel', handover, { passive: true, once: false });
        addEventListener('touchmove', handover, { passive: true, once: false });
        addEventListener('keydown', handover, { passive: true, once: false });

        // On load the shards come in from further out than they ever fly, so the
        // mark assembles out of the same fracture it will later break along.
        gsap.fromTo(pieces,
          { xPercent:  (i, el) => +el.dataset.dx * 1.5,
            yPercent:  (i, el) => +el.dataset.dy * 1.5,
            rotationZ: (i, el) => +el.dataset.rot * 1.4,
            rotationY: (i, el) => +el.dataset.ry * 1.4,
            z: -420, opacity: 0 },
          { xPercent: 0, yPercent: 0, rotationZ: 0, rotationY: 0, z: 0, opacity: 1,
            // eleven shards, so the stagger is shorter than it was for three —
            // 0.11 each would have run the intro past two seconds.
            duration: 1.5, ease: 'expo.out', stagger: 0.045, delay: 0.25,
            onComplete: armScroll });
        setTimeout(armScroll, 2600);   // whichever comes first

        // A tab that is hidden at load never runs rAF, so the intro cannot play
        // and the shards would sit at its from-state — invisible, and scattered
        // once the visibility failsafe reveals them. Arming immediately puts
        // them assembled and visible without waiting on a clock that is not
        // ticking. This is the case that actually loses the mark: open the site
        // in a background tab, come back, and it is gone.
        if (document.hidden) armScroll();
        document.addEventListener('visibilitychange', () => {
          if (document.hidden) armScroll();
        }, { once: true });
      }

      // ── THE ACT WORDS ────────────────────────────────────────────────────
      // All three treatments used to be timed to the word's ARRIVAL and were
      // spent before anyone could look: the aberration collapsed from 16px to
      // 1px exactly as the section pinned, and the anaglyph settled to 4px as
      // its panel centred. The effect always finished a beat before the word
      // became the thing on screen, which is why it read as missing.
      //
      // Each one now swells INTO its word, HOLDS at full separation while the
      // word is centred, and resolves only as it leaves. Separation is in `em`
      // so it scales with the type instead of shrinking against a huge word,
      // capped at the doctrine's 0.06em.
      const pinST = triTl && triTl.scrollTrigger;
      const pinLen = () => (pinST ? pinST.end - pinST.start : 0);
      // Four panels across three viewports of travel, so panel i sits fully on
      // screen at pin progress i/3.
      const atPanel = (i, before, after) => ({
        start: () => pinST.start + Math.max(0, i / 3 - before) * pinLen(),
        end: () => pinST.start + Math.min(1, i / 3 + after) * pinLen(),
        scrub: 0.9,
        invalidateOnRefresh: true,
      });

      // 0 -> max -> hold -> 0. The hold is the whole point: the split stays at
      // full width for the stretch where the word is what the reader is looking
      // at, rather than peaking in passing.
      const swell = (el, prop, max, st) => {
        const tl = gsap.timeline({ scrollTrigger: st });
        tl.fromTo(el, { [prop]: '0em' }, { [prop]: max, ease: 'power2.out', duration: 1 })
          .to(el, { [prop]: max, duration: 1.6 })
          .to(el, { [prop]: '0em', ease: 'power2.in', duration: 1 });
        return tl;
      };

      // Each panel's content comes inward as its panel arrives. Driven off the
      // pin window rather than containerAnimation: containerAnimation maps a
      // panel's HORIZONTAL position onto a single linear tween, which cannot
      // survive a path that turns corners. This was the last thing holding the
      // rail to a straight line.
      document.querySelectorAll('.panel').forEach((panel, i) => {
        const body = panel.querySelector('.panel__body');
        if (!body) return;
        gsap.fromTo(body,
          { z: -220, opacity: 0.4 },
          { z: 0, opacity: 1, ease: 'none',
            scrollTrigger: pinST
              ? (i === 0
                  // Panel 0 must arrive on the VERTICAL approach, finishing
                  // before the section pins. Measured against the rail it could
                  // not: the rail does not begin until the lead-in is over, so
                  // WORDS sat at 40% for the whole dwell that exists to let it
                  // be read, and only came up to full strength as the rail
                  // started carrying it away.
                  // End given as an ABSOLUTE scroll position, not 'top 20%'.
                  // `tri` is pinned, and a relative end measured against a
                  // pinned element does not resolve — the reveal simply never
                  // ran and WORDS stayed at 40% for the whole section. Ending
                  // exactly at pin engagement means it is at full strength for
                  // every pixel of the dwell.
                  ? { trigger: tri, start: 'top 85%',
                      end: () => (triPin ? triPin.start : 0),
                      scrub: 0.5, invalidateOnRefresh: true }
                  // Negative 'after': the reveal completes a tenth of the path
                  // BEFORE the panel is centred, so it is already composed when
                  // it arrives rather than resolving under the reader's eye.
                  : atPanel(i, 0.34, -0.10))
              : { trigger: panel, start: 'top 80%', end: 'center 60%', scrub: 0.5 } });
      });

      const chroma = document.querySelector('.panel__word--chroma');
      if (chroma) {
        // WORDS is the first panel: it is already centred when the pin begins,
        // so its swell starts during the vertical approach and carries into the
        // pin. Driven off the panel's own horizontal position it would have no
        // room at all — at rail x=0 that range is already spent.
        swell(chroma, '--ab', '0.06em', pinST
          ? { trigger: tri, start: 'top 78%', end: () => pinST.start + 0.24 * pinLen(),
              scrub: 0.9, invalidateOnRefresh: true }
          : { trigger: tri, start: 'top 85%', end: 'top 20%', scrub: 0.9 });
      }

      const ana = document.querySelector('.panel__word--anaglyph');
      if (ana) {
        swell(ana, '--eye', '0.06em', pinST
          ? atPanel(2, 0.22, 0.16)
          : { trigger: ana.closest('.panel'), start: 'top 85%', end: 'bottom 40%', scrub: 0.9 });
      }

      // ── THE TELLS ARRIVE FROM FOUR BEARINGS ──────────────────────────────
      // Each panel's copy comes in from its own direction, so moving through the
      // rail does not feel like the same reveal four times. Every bearing is
      // paired with depth: the Z-Axis Rule forbids arriving by translate alone,
      // and a flat slide reads as a slideshow rather than as something entering
      // the room.
      //
      // Deliberately NOT animating opacity. The panel body already fades, and a
      // second opacity tween on the same content means that if a trigger ever
      // fails to fire, the copy is stranded invisible with no way back. Stranded
      // OFF to one side is recoverable and readable; stranded invisible is the
      // failure that lost the wordmark.
      // Each line arrives on its own beat. Moving the whole block as one
      // rectangle is what made this read as a card sliding: however far a rigid
      // slab travels, nothing is happening INSIDE it. Staggering the tag, the
      // heading, the paragraphs, the links and the quote is what turns an
      // entrance into choreography.
      const BEARINGS = [
        { x: -300, y: 0, ry: 20, rx: 0 },    // WORDS from the left, turning in
        { x: 0, y: 230, ry: 0, rx: -18 },    // CODE  up from below, tipping level
        { x: 300, y: 0, ry: -20, rx: 0 },    // MUSIC from the right, turning in
        { x: 0, y: -230, ry: 0, rx: 18 },    // BOOK  down from above, tipping level
      ];
      document.querySelectorAll('.panel__tell').forEach((tell, i) => {
        const b = BEARINGS[i % BEARINGS.length];
        const kids = [...tell.children];
        // Panel 0 is already centred when the pin begins, so its own horizontal
        // range is spent before it could animate. It rides the vertical approach
        // instead, exactly as the chromatic aberration does.
        // Widened from the earlier window, because a stagger needs room: the
        // last line still has to land before its panel starts leaving.
        const st = (pinST && i > 0)
          ? atPanel(i, 0.31, 0.10)
          : pinST
            ? { trigger: tri, start: 'top 72%', end: () => pinST.start + 0.17 * pinLen(),
                scrub: 0.9, invalidateOnRefresh: true }
            : { trigger: tell.closest('.panel'), start: 'top 88%', end: 'center 62%', scrub: 0.9 };
        gsap.fromTo(kids,
          { x: b.x, y: b.y, z: -520, rotationY: b.ry, rotationX: b.rx },
          { x: 0, y: 0, z: 0, rotationY: 0, rotationX: 0,
            ease: 'power3.out', stagger: 0.085, scrollTrigger: st });
      });

      // ── THE LAST TURN ────────────────────────────────────────────────────
      // The close arrives from the right, so the page reads down, right, down,
      // left, down, right rather than ending on a second screen of scrolling
      // down. Its wrapper pins for one viewport and the section travels across
      // a paper ground.
      //
      // Only the close is a travelling panel. The Jonathan act ahead of it is
      // taller than a viewport at desktop sizes, so putting the pair in a rail
      // together would clip it; sliding the close OVER a matching ground gets
      // the same turn without touching that section's layout.
      const endWrap = document.querySelector('[data-endwrap]');
      const endSec = endWrap && endWrap.querySelector('.end');
      if (endWrap && endSec && window.matchMedia('(min-width: 700px)').matches) {
        gsap.fromTo(endSec,
          { xPercent: 100 },
          { xPercent: 0, ease: 'none',
            scrollTrigger: {
              trigger: endWrap,
              start: 'top top',
              end: () => '+=' + Math.round(window.innerHeight * 1.15),
              pin: true,
              scrub: 0.8,
              invalidateOnRefresh: true,
              anticipatePin: 1,
            } });
      }

      // ── CODE: the word scrambles, then resolves ──────────────────────────
      const scr = document.querySelector('.panel__word--scramble span');
      if (scr) {
        const FINAL = scr.dataset.final || scr.textContent;
        const GLYPHS = '01<>[]{}/\\#$%&*+=~^ABCDEFGHIJKLMNOPQRSTUVWXYZ';
        let raf = 0;
        const run = () => {
          cancelAnimationFrame(raf);
          const start = performance.now();
          const DUR = 2400;   // was 900 — over before it registered
          const tick = (now) => {
            const t = Math.min(1, (now - start) / DUR);
            // characters resolve left to right
            const settled = Math.floor(t * FINAL.length * 1.08);  // churn longer before resolving
            let out = '';
            for (let i = 0; i < FINAL.length; i++) {
              out += i < settled ? FINAL[i] : GLYPHS[(Math.random() * GLYPHS.length) | 0];
            }
            scr.textContent = out;
            if (t < 1) raf = requestAnimationFrame(tick);
            else scr.textContent = FINAL;
          };
          raf = requestAnimationFrame(tick);
        };
        // Fires as CODE reaches the middle of the screen, not as its edge
        // appears — the decode should happen under the reader's eye.
        ScrollTrigger.create(pinST
          ? { trigger: tri,
              start: () => pinST.start + Math.max(0, 1 / 3 - 0.16) * pinLen(),
              end: () => pinST.start + Math.min(1, 1 / 3 + 0.16) * pinLen(),
              invalidateOnRefresh: true, onEnter: run, onEnterBack: run }
          : { trigger: scr.closest('.panel'), start: 'top 70%', onEnter: run, onEnterBack: run });
      }

      ScrollTrigger.refresh();
    };

    if (reduce) composeStatically();
    else if (window.__motion && !window.__motion.reduce) wireScrubbed(window.__motion);
    else {
      // Motion stack still booting — attach when it signals, but never leave the
      // page blank if it fails to arrive at all.
      let wired = false;
      addEventListener('motion:ready', (e) => {
        if (wired) return;
        wired = true;
        e.detail && !e.detail.reduce ? wireScrubbed(e.detail) : composeStatically();
      }, { once: true });
      setTimeout(() => { if (!wired) { wired = true; composeStatically(); } }, 2500);
    }

    // scroll: HUD readout, percent, texture parallax, hero deck recede
    const hud = document.querySelector('[data-hud]');
    const pct = document.querySelector('[data-pct]');
    const marks = [...document.querySelectorAll('[data-hud]')].filter((m) => m.dataset.hud);
    const layers = reduce ? [] : [...document.querySelectorAll('[data-par]')];
    let tick = false;
    const draw = () => {
      tick = false;
      const sy = window.scrollY;
      const doc = document.body.scrollHeight - window.innerHeight;
      const p = Math.min(1, Math.max(0, sy / (doc || 1)));
      if (pct) pct.textContent = String(Math.round(p * 100)).padStart(2, '0');
      const mid = sy + window.innerHeight * 0.5;
      let cur = null;
      for (const m of marks) if (m.offsetTop <= mid) cur = m.dataset.hud;
      if (hud && cur && hud.textContent !== cur) hud.textContent = cur;
      for (const l of layers) {
        const host = l.parentElement.parentElement;
        l.style.transform = `translate3d(0,${((sy - host.offsetTop) * parseFloat(l.dataset.par)).toFixed(1)}px,0)`;
      }
    };
    addEventListener('scroll', () => { if (!tick) { tick = true; requestAnimationFrame(draw); } }, { passive: true });
    draw();
  </script>
</Base>

<style>
  /* ══════ TYPE: matte grotesque + typewriter. No serif. ══════ */
  main{--grot:"Archivo",ui-sans-serif,system-ui,sans-serif;
    --tw:"Courier Prime",ui-monospace,"SF Mono",monospace;
    --wire-bg:#04060B; --lit:#40C4E8; --edge:rgba(64,196,232,.18); --edge-lit:rgba(64,196,232,.85);
    --paper:#EDEAE3; --dusk:#171512; --ink:#1B1916}

  /* ══════ HUD chrome ══════ */
  .seal{position:fixed; top:14px; left:14px; z-index:99; width:38px; height:38px; border-radius:50%;
    background:rgba(0,0,0,.62); display:grid; place-items:center;
    box-shadow:0 0 0 1px rgba(255,255,255,.22), 0 2px 12px rgba(0,0,0,.6);
    transition:box-shadow 900ms cubic-bezier(.2,.8,.2,1)}
  .seal:hover{box-shadow:0 0 0 1px var(--edge-lit), 0 0 22px rgba(64,196,232,.5)}
  .seal img{width:18px; height:auto}
  .hud{position:fixed; z-index:99; padding:7px 11px; text-decoration:none;
    background:rgba(8,10,14,.55); -webkit-backdrop-filter:blur(8px); backdrop-filter:blur(8px);
    box-shadow:inset 0 0 0 1px rgba(255,255,255,.16)}
  .hud span{font-family:var(--tw); font-size:10px; letter-spacing:.18em; text-transform:uppercase;
    color:#EAF2F6; white-space:nowrap}
  .hud--tr{top:14px; right:14px}
  .hud--tr:hover{box-shadow:inset 0 0 0 1px var(--edge-lit)}
  .hud--bl{bottom:14px; left:14px; pointer-events:none}
  .hud--br{bottom:14px; right:14px; pointer-events:none}
  .hud--br span{color:var(--lit)}
  @media(max-width:640px){.hud--bl{display:none}}

  /* ══════ 01 HERO — perspective, the ground falls away ══════ */
  .hero{position:relative; min-height:100svh; display:grid; place-items:center; overflow:hidden;
    background:#04060B; color:#E9E4D8; padding:9vh 5vw 11vh}


  .hero__body{position:relative; z-index:3; text-align:center; max-width:70ch;
    transform-style:preserve-3d; padding:clamp(1.5rem,4vw,3rem) clamp(1.5rem,5vw,4rem)}
  /* the streams run behind the text, so the copy gets its own bed of dark */
  .hero__body::before{content:""; position:absolute; inset:-6% -8%; z-index:-1; border-radius:50%;
    background:radial-gradient(62% 58% at 50% 50%, rgba(4,6,11,.82) 0%, rgba(4,6,11,.5) 62%, transparent 84%)}

  /* The mark's geometry, camera and shard styling live in Mark.astro. */

  /* pieces fly together on load... */

  .rv{display:inline-block}
  :global(.js) .rv{clip-path:inset(0 100% 0 0); opacity:0;
    animation:rvIn 1000ms cubic-bezier(.16,1,.3,1) 1200ms forwards}
  :global(.js) .rv--2{animation-delay:1650ms}
  :global(.js) .rv--3{animation-delay:2150ms}
  @keyframes rvIn{to{clip-path:inset(0 0 0 0); opacity:1}}

  /* THREE LINES, ONE VOICE.
     Every attempt to differentiate these — a size ramp, a colour that
     brightened, a cyan alias — read as separate scraps rather than one
     introduction. So they now share a single treatment outright: same face,
     same size, same colour, same tracking, same case. The spacing comes from
     the shared line-height, so the three sit as one block instead of three
     stacked objects.

     No accent colour here at all. Cyan is the brand's future pole and it earns
     its place on the wire ground and the CTA; spent on a name in the hero it
     was simply the loudest thing on screen.

     The group stays small against the wordmark — that contrast is doctrine and
     nothing here scales with the mark. */
  .hero__name,
  .hero__line{font-family:var(--tw); font-size:clamp(1rem,2.1vw,1.2rem);
    line-height:2; letter-spacing:.02em; color:#EDE9DF; margin:0;
    text-transform:none}
  /* A line of air between the two, so they read as two statements rather than
     a wrapped paragraph. */
  .hero__name{margin-bottom:.55em}

  .hero__tail{font-family:var(--tw); font-size:clamp(.82rem,1.5vw,.98rem); line-height:1.85;
    color:#8C9BA3; max-width:54ch; margin:0 auto}


  /* Lifted clear of the sound toggle. Both are fixed bottom-centre and the cue
     was running 18px straight through the button — invisible before, when the
     button was a short "Sound", obvious now it carries a sentence. */
  .cue{position:absolute; left:50%; bottom:58px; translate:-50% 0; width:1px; height:44px; z-index:4}
  .cue span{display:block; width:1px; height:100%;
    background:linear-gradient(180deg, transparent, var(--lit), transparent);
    animation:cue 2.6s cubic-bezier(.2,.8,.2,1) infinite}
  @keyframes cue{0%{opacity:0; transform:translateY(-10px)} 40%{opacity:1} 100%{opacity:0; transform:translateY(16px)}}

  :global(.js) .hero.set .rv,
  :global(.js) .hero.set .mk{opacity:1; transform:none; clip-path:none; filter:none; animation:none}

  /* ══════ ACTS — contrast flips section to section ══════ */
  .act{position:relative; overflow-x:clip; padding:clamp(5rem,12vw,9rem) 5vw clamp(5rem,12vw,9rem)}
  .act--paper{background:var(--paper); color:var(--ink)}

  /* the act word — huge, matte, tracked tight, clipped at the top edge */
  .act__word{position:relative; z-index:2; margin:0 0 clamp(2.5rem,6vw,4.5rem); overflow:hidden}
  .act__word span{display:block; font-family:var(--grot); font-weight:900;
    font-size:clamp(3.4rem,17vw,13rem); letter-spacing:-.055em; line-height:.86;
    color:currentColor; opacity:.13}

  /* ══════ STAGE + things that GROW toward you ══════ */
  .stage{position:relative; z-index:2; display:grid; grid-template-columns:1fr;
    gap:clamp(2rem,5vw,4rem); align-items:center; max-width:1180px; margin:0 auto;
    padding-block:clamp(3rem,8vw,6rem); perspective:1100px}
  @media(min-width:900px){
    .stage{grid-template-columns:1.05fr .95fr; gap:clamp(2.5rem,6vw,5rem)}
    .stage--flip figure{order:2} .stage--flip .tell{order:1}
  }
  .stage--solo{grid-template-columns:1fr; place-items:center; text-align:center}
  @media(min-width:900px){.stage--solo{grid-template-columns:1fr}}

  figure{margin:0}
  .grow{transform-style:preserve-3d}
  /* Any figure image sitting directly in a stage gets the same frame, however it
     arrives (grow or slide). Without the .slide arm the portrait fell back to its
     natural size — uncropped and enormous. */
  /* INVARIANT: image sizing keys on a figure's structural position, never on
     its animation class. .grow / .slide carry motion only — swapping one for
     the other must not change dimensions. Keying sizing to .grow is what made
     the Words portrait render at natural size when it became a .slide. */
  /* :where() keeps this at zero specificity for the container part, so a
     per-figure exception can always override it. Without it, Astro's scoping
     attributes push this rule above `figure.is-wide img` and the exception
     silently loses — which is how the wide lightform got cropped to 4:5. */
  /* SIZE BUDGET. Sizing to column width alone let a 4:5 portrait render taller
     than two screens on a short viewport. Width is now capped by a share of
     viewport HEIGHT, so an image can never dominate the screen it sits on. */
  main{--fig-h:min(70svh, 672px)}   /* +20% over the first pass */
  :where(.stage) figure{max-width:calc(var(--fig-h) * 0.8); margin-inline:auto}
  /* wide artwork needs the same height budget — capping width alone let the
     lightform stand taller than the viewport it sits in */
  :where(.stage) figure.is-wide{max-width:min(100%, calc(var(--fig-h) * 1.6))}

  /* THE PLATE — a frame in the page's own register: hairline mat plus corner
     ticks, the same glass-HUD vocabulary as the corner consoles. Reads on both
     paper and night grounds because it is built from alpha, not a fixed colour. */
  :where(.stage, .end__body) figure{position:relative;
    padding:clamp(7px,0.9vw,13px);
    background:color-mix(in srgb, currentColor 6%, transparent);
    box-shadow:inset 0 0 0 1px color-mix(in srgb, currentColor 18%, transparent)}
  :where(.stage, .end__body) figure::before,
  :where(.stage, .end__body) figure::after{content:""; position:absolute;
    width:11px; height:11px; pointer-events:none;
    border:1px solid color-mix(in srgb, currentColor 52%, transparent)}
  :where(.stage, .end__body) figure::before{top:4px; left:4px; border-right:0; border-bottom:0}
  :where(.stage, .end__body) figure::after{bottom:4px; right:4px; border-left:0; border-top:0}
  /* the electric act gets lit register marks */
  /* the paper acts get a warm mat instead of a neutral one — bone board, kraft
     hairline, rust ticks. Same plate, Southern side of the page. */
  .act--paper figure{background:var(--bone); box-shadow:inset 0 0 0 1px rgba(199,169,111,.55),
    0 26px 56px -26px rgba(51,48,58,.42)}
  .act--paper figure::before, .act--paper figure::after{border-color:var(--rust); opacity:.7}

  :where(.stage, .end__body) figure img{display:block; width:100%; height:auto; aspect-ratio:4/5; object-fit:cover;
    box-shadow:0 40px 90px -28px rgba(0,0,0,.7)}
  .grow--a{--tilt:-1.6deg} .grow--b{--tilt:1.8deg}
  .grow--c{--tilt:1.4deg} .grow--d{--tilt:-1.9deg} .grow--e{--tilt:0deg}

  /* a type slab standing in for a cover */
  .slab{aspect-ratio:4/5; display:grid; place-items:center; padding:12%;
    background:linear-gradient(150deg,#20242B,#0D1014);
    box-shadow:0 40px 90px -28px rgba(0,0,0,.7), inset 0 0 0 1px rgba(255,255,255,.08)}
  .slab span{font-family:var(--grot); font-weight:900; font-size:clamp(1.2rem,3.2vw,2.3rem);
    letter-spacing:-.02em; line-height:1.02; color:#E9E4D8; text-align:center}

  .tell{max-width:52ch}
  .tell--mid{margin-inline:auto; text-align:center}
  .tag{font-family:var(--tw); font-size:.82rem; letter-spacing:.24em; text-transform:uppercase;
    color:#C1512A; margin:0 0 1rem}
  .tag--lit{color:var(--lit)}
  .tell h3{font-family:var(--grot); font-weight:800; font-size:clamp(1.7rem,4vw,2.9rem);
    letter-spacing:-.035em; line-height:1.02; margin:0 0 1.1rem}
  .h3--lit{color:var(--lit); text-shadow:0 0 40px rgba(64,196,232,.4)}
  .tell p{font-family:var(--tw); font-size:clamp(.86rem,1.5vw,1rem); line-height:1.9;
    opacity:.82; margin:0 0 1.3rem}
  .lnk{font-family:var(--tw); font-size:.8rem; letter-spacing:.14em; text-transform:uppercase;
    text-decoration:none; color:inherit; border-bottom:2px solid #C1512A; padding-bottom:3px;
    transition:border-color 700ms ease, color 700ms ease}
  .lnk:hover{color:#C1512A}
  .lnk--lit{border-color:var(--lit)} .lnk--lit:hover{color:var(--lit)}
  /* Amber, not the default rust: DESIGN.md gives amber to links on dusk
     grounds and keeps rust for paper. */
  .lnk--amber{border-color:var(--amber)} .lnk--amber:hover{color:var(--amber)}
  /* the lightform capture is wide, not a 4:5 portrait */
  .grow--f{--tilt:0deg}
  /* deliberate exceptions: wide artworks, not portraits */
  figure.is-wide img{aspect-ratio:auto; object-fit:contain}

  /* act words arrive from the sides — the section builds itself */



  /* ══════ THE TRIPTYCH — the three crafts, side by side ══════
     One pinned section; the rail carries three full-viewport panels so the
     ground colour changes as you travel sideways rather than as you scroll down.
     The contrast cut happens horizontally here. */
  /* The generic `section` rule in global.css applies padding-block:
     clamp(4rem,9vw,8rem). This section is a full-viewport pinned rail whose
     panels carry their own padding, so that outer pad was applied twice — and
     because the section is 100svh, it ate INTO the viewport: the rail was
     squeezed to 219px inside a 347px section, leaving a dead band of ground
     above and below and clipping the bottom of every panel. */
  .tri{position:relative; z-index:2; overflow:hidden; height:100svh; padding-block:0}
  .tri__spring{width:max-content; height:max-content; will-change:transform}
  /* A 2x2 board, not a strip. The path crosses the top, drops down the right
     side, and comes back across the bottom, so the reader changes direction
     three times instead of running one way for four screens. */
  .tri__rail{display:grid; grid-template-columns:100vw 100vw; grid-template-rows:100svh 100svh;
    width:200vw; height:200svh; will-change:transform}
  /* placed explicitly: auto-flow would fill left-to-right on both rows and put
     the fourth panel under the first, which is a zigzag, not a serpentine */
  .panel:nth-child(1){grid-area:1 / 1}   /* WORDS  top left   */
  .panel:nth-child(2){grid-area:1 / 2}   /* CODE   top right  */
  .panel:nth-child(3){grid-area:2 / 2}   /* MUSIC  bottom right */
  .panel:nth-child(4){grid-area:2 / 1}   /* BOOK   bottom left  */
  .panel{position:relative; width:100vw; height:100svh; overflow:hidden;
    display:flex; flex-direction:column; justify-content:center;
    padding:clamp(4rem,8vw,7rem) 6vw clamp(3rem,6vw,5rem)}
  /* the first panel is the one the reader meets mid-stride — give it room */
  .panel:first-child{padding-left:clamp(2rem,10vw,9rem)}
  .panel--paper{background:var(--paper); color:var(--ink)}
  .panel--dusk{background:var(--dusk); color:#E9E4D8}
  .panel--wire{background:var(--wire-bg); color:#DFF2F8}

  /* flex:none is load-bearing. .panel is a flex column of fixed height, and a
     flex item carrying overflow:hidden is free to be shrunk to nothing — so as
     soon as the panel's contents outgrew its height, the act word was crushed
     to a 0px box and its own overflow clipped every glyph. It read as the word
     being cut off. It must hold its size and let the column give elsewhere. */
  .panel__word{position:relative; z-index:2; flex:none;
    margin:0 0 clamp(1rem,2.4vw,2rem); overflow:hidden}
  .panel__word span{display:block; font-family:var(--grot); font-weight:900;
    font-size:clamp(2.6rem,11vw,8rem); letter-spacing:-.055em; line-height:.86;
    color:currentColor; opacity:.14}
  /* paper grounds need real weight — .14 disappeared into the noise field */
  /* Doctrine floors channel opacity at .5 against light grounds; .42 sat under
     it and the fringes disappeared into the paper. */
  .panel--paper .panel__word span, .panel--book .panel__word span{opacity:.56}
  .panel--wire .panel__word span{opacity:1; color:var(--lit);
    text-shadow:0 0 60px rgba(64,196,232,.45), 0 0 160px rgba(64,196,232,.25)}

  /* WORDS — chromatic aberration: the same glyphs in R and C, fringing apart */
  .panel__word--chroma span{position:relative}
  .panel__word--chroma span::before,
  .panel__word--chroma span::after{content:attr(data-t); position:absolute; inset:0;
    pointer-events:none;
    /* multiply, not screen: screen LIGHTENS, so on paper the fringes went white
       and bleached the word instead of colouring its edges */
    mix-blend-mode:multiply}
  .panel__word--chroma span::before{color:#E01B1B; transform:translate(var(--ab,0px),0)}
  .panel__word--chroma span::after{color:#00B7D8; transform:translate(calc(var(--ab,0px) * -1),0)}

  /* MUSIC — anaglyph: a stereo pair, offset far enough to read as depth */
  .panel__word--anaglyph span{position:relative}
  .panel__word--anaglyph span::before,
  .panel__word--anaglyph span::after{content:attr(data-t); position:absolute; inset:0;
    pointer-events:none; mix-blend-mode:screen; opacity:.85}
  .panel__word--anaglyph span::before{color:#FF1F1F; transform:translate3d(calc(var(--eye,0px) * -1),0,-40px)}
  .panel__word--anaglyph span::after{color:#00E5FF; transform:translate3d(var(--eye,0px),0,40px)}

  .panel__body{position:relative; z-index:2; display:grid; grid-template-columns:1fr;
    gap:clamp(1.4rem,3vw,2.6rem); align-items:center; max-width:1180px; perspective:1100px}
  @media(min-width:820px){.panel__body{grid-template-columns:0.85fr 1fr}}

  .panel__fig{margin:0; position:relative; max-width:calc(var(--fig-h) * 0.62);
    padding:clamp(7px,0.9vw,13px);
    background:color-mix(in srgb, currentColor 6%, transparent);
    box-shadow:inset 0 0 0 1px color-mix(in srgb, currentColor 18%, transparent)}
  .panel__fig.is-wide{max-width:min(100%, calc(var(--fig-h) * 1.25))}
  .panel__fig img{display:block; width:100%; height:auto; aspect-ratio:4/5; object-fit:cover}
  .panel__fig.is-wide img{aspect-ratio:auto; object-fit:contain}
  .panel__fig::before, .panel__fig::after{content:""; position:absolute; width:11px; height:11px;
    pointer-events:none; border:1px solid color-mix(in srgb, currentColor 50%, transparent)}
  .panel__fig::before{top:4px; left:4px; border-right:0; border-bottom:0}
  .panel__fig::after{bottom:4px; right:4px; border-left:0; border-top:0}
  /* warm plate on the paper panel, lit ticks on the electric one */
  .panel--paper .panel__fig{background:var(--bone);
    box-shadow:inset 0 0 0 1px rgba(199,169,111,.55), 0 26px 56px -26px rgba(51,48,58,.42)}
  .panel--paper .panel__fig::before, .panel--paper .panel__fig::after{border-color:var(--rust); opacity:.7}
  .panel--wire .panel__fig::before, .panel--wire .panel__fig::after{border-color:var(--lit); opacity:.75}

  /* the book panel: warm paper ground, the noise field blooming behind it */
  .panel--book{background:#E7E0D2; color:var(--ink); isolation:isolate}
  .panel--book .panel__word span{opacity:.16}
  .panel__body--wide{grid-template-columns:1fr !important; max-width:64ch}

  /* Its own camera, so the lines can turn as they arrive. Perspective on
     .panel__body reaches this element but not its children. */
  /* THE WORD ON HIM. Dusk, deliberately: the hero is wire and WORDS is paper,
     so putting this on paper would mean two paper grounds meeting with no cut
     between them. A warm dark here keeps the hard edge where it belongs, on
     the way into WORDS. */
  .say{position:relative; overflow:hidden; background:var(--dusk); color:#E9E4D8;
    min-height:42svh; display:grid; place-items:center;
    padding:clamp(3rem,7vw,5rem) 6vw}
  /* Runs the long way across rather than stacking into a narrow column. At 26ch
     this broke into five short lines and the section had to be tall to hold
     them; given the width it lands in one or two and the panel comes down with
     it. Still capped, because a display line past ~70 characters stops being
     read in one go. */
  .say__quote{position:relative; z-index:2; margin:0;
    max-width:min(92vw, 70ch); text-align:center}
  .say__quote p{font-family:var(--grot); font-weight:800; font-size:clamp(1.2rem,4.4vw,2.3rem);
    line-height:1.18; letter-spacing:-.03em; margin:0 0 clamp(1rem,2.2vw,1.5rem);
    text-wrap:balance}
  .say__quote cite{font-family:var(--tw); font-style:normal; font-size:.7rem;
    letter-spacing:.2em; text-transform:uppercase; color:var(--amber)}

  /* the aside inside a tell: a punchline, so it changes face rather than size */
  .aside{font-family:var(--grot); font-weight:800; font-size:1.2rem;
    letter-spacing:-.02em; margin:0 0 1rem}
  /* A quote set INSIDE a panel is part of the copy and takes the copy's size.
     Only a quote with a panel to itself is allowed to be a monument. */
  /* Doubled class deliberately: the generic .pull p rule is declared LATER in
     this sheet, and at equal specificity source order wins — so a single class
     here lost and the quote kept the monument size. */
  .pull--amber{border-top-color:rgba(199,169,111,.55)}
  .pull.pull--amber p{font-family:var(--tw); font-weight:400;
    font-size:clamp(.86rem,1.5vw,1rem); line-height:1.9; letter-spacing:0;
    color:inherit}
  .pull.pull--amber cite{color:inherit}

  .panel__tell{max-width:52ch; perspective:900px}

  /* THE PULL QUOTE. The only place on this page where a voice other than his
     own speaks, so it changes FACE rather than just getting louder: the display
     grotesque against the Courier body copy around it. Both clamp endpoints are
     documented type steps, and the hairline uses the chrome scrim set. */
  .pull{margin:clamp(1.4rem,3vw,2.2rem) 0 0; padding-top:clamp(1rem,2.2vw,1.5rem);
    border-top:1px solid rgba(51,48,58,.42)}
  .pull p{font-family:var(--grot); font-weight:800; font-size:clamp(1.2rem,3.2vw,2.3rem);
    line-height:1.2; letter-spacing:-.03em; margin:0 0 .8rem; text-wrap:balance}
  .pull cite{font-family:var(--tw); font-style:normal; font-size:.7rem; letter-spacing:.2em;
    text-transform:uppercase; color:var(--rust)}
  .panel__links{display:flex; gap:clamp(1rem,2.4vw,2rem); flex-wrap:wrap}

  /* below the pin gate the triptych reads as three ordinary stacked sections */
  @media(max-width:699px){
    .tri{height:auto; overflow:visible}
    .endwrap{height:auto; overflow:visible}
    .end{position:static; transform:none !important}
    .tri{height:auto}
    .tri__spring{width:100%; height:auto; transform:none !important}
    .tri__rail{display:block; width:100%; height:auto; transform:none !important}
    /* the board collapses back to one column, so the explicit placement above
       has to be released or the panels stack in grid order, not reading order */
    .panel:nth-child(1), .panel:nth-child(2),
    .panel:nth-child(3), .panel:nth-child(4){grid-area:auto}
    .panel{width:100%; height:auto; min-height:auto; padding-block:clamp(3.5rem,10vw,5rem)}
  }


  /* ══════ 04 wire — live current running through ══════ */
  .wire{position:absolute; inset:0; z-index:1; pointer-events:none; overflow:hidden}
  .wire span{position:absolute; left:0; right:0; height:1px; background:var(--lit); opacity:.5;
    box-shadow:0 0 12px var(--lit); transform-origin:left}
  .wire span:nth-child(1){top:22%; animation:run 5.5s linear infinite}
  .wire span:nth-child(2){top:54%; animation:run 7.5s linear infinite 1.4s}
  .wire span:nth-child(3){top:79%; animation:run 6.5s linear infinite .7s}
  @keyframes run{0%{transform:scaleX(0); opacity:0} 12%{opacity:.55}
    88%{opacity:.55} 100%{transform:scaleX(1); opacity:0}}

  /* ══════ 06 END ══════ */
  /* The last turn. The close travels in from the right across a paper ground,
     so the final move is sideways rather than a sixth screen of scrolling down.
     Only the close has to fit one viewport for this to work: the Jonathan act
     before it stays a normal, taller, vertically scrolling section, which is why
     it is not in a rail with it. */
  .endwrap{position:relative; height:100svh; overflow:hidden; background:var(--paper)}
  .end{position:absolute; inset:0; display:grid; align-content:center;
    overflow:hidden; background:#0A0C10; color:#E9E4D8;
    padding:clamp(5rem,12vw,9rem) 5vw clamp(2.5rem,5vw,3.5rem); text-align:center}
  .end__body{position:relative; z-index:2; max-width:760px; margin:0 auto; perspective:1100px}
  .end__art{max-width:420px; margin:0 auto clamp(2rem,4vw,3rem)}
  .end__art img{box-shadow:0 30px 70px -24px rgba(0,0,0,.75)}
  .end__word{font-family:var(--grot); font-weight:900; font-size:clamp(2.1rem,9vw,6.4rem);
    letter-spacing:-.05em; line-height:.92; margin:0 0 1.4rem; color:#E9E4D8}
  .end__copy{font-family:var(--tw); font-size:clamp(.86rem,1.5vw,1rem); line-height:1.9;
    color:#9FB0B8; max-width:44ch; margin:0 auto clamp(2rem,4vw,2.6rem)}
  .cta{display:inline-block; font-family:var(--tw); font-size:.82rem; letter-spacing:.2em;
    text-transform:uppercase; text-decoration:none; color:#06080C; background:var(--lit);
    padding:1rem 2.2rem; box-shadow:0 0 40px rgba(64,196,232,.4);
    transition:box-shadow 700ms ease, transform 700ms cubic-bezier(.2,.8,.2,1)}
  .cta:hover{transform:translateY(-2px); box-shadow:0 0 64px rgba(64,196,232,.7)}
  .colophon{position:relative; z-index:2; margin:clamp(3.5rem,8vw,6rem) 0 0;
    font-family:var(--tw); font-size:.68rem; letter-spacing:.18em; text-transform:uppercase;
    color:#5C6870}

  /* ══════ reduced motion ══════ */
  @media (prefers-reduced-motion:reduce){
    /* no pin, no scrub — everything sits composed and static */
    .act__word, .act__word span{position:static !important; opacity:inherit}
    :global(.js) .hero__mark, :global(.js) .rv, :global(.js) .mk,
    :global(.js) .grow, :global(.js) .tell, :global(.js) .act__word span, :global(.js) .panel__body{
      opacity:1; transform:none; clip-path:none; filter:none; animation:none; transition:none}
    .cue span, .wire span{animation:none}
    /* THE BOARD COMES APART. Without this the rail keeps its 2x2 grid inside a
       one-viewport clip while nothing is left to move it, so WORDS is all a
       reduced-motion reader ever sees and CODE, MUSIC and THE BOOK are
       unreachable. Same collapse the narrow-screen fallback performs. */
    .tri{height:auto; overflow:visible}
    .tri__spring{width:100%; height:auto; transform:none !important}
    .tri__rail{display:block; width:100%; height:auto; transform:none !important}
    .panel:nth-child(1), .panel:nth-child(2),
    .panel:nth-child(3), .panel:nth-child(4){grid-area:auto}
    .panel{width:100%; height:auto; min-height:auto}
    .endwrap{height:auto; overflow:visible}
    .end{position:static; transform:none !important}
    /* the reel becomes an ordinary swipeable row — no pin, no forced travel */
    /* the canvas well and the texture layers are guarded inside their own
       components — Astro scoping means index.astro cannot reach them. */
  }
