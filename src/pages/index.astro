---
import Base from '../layouts/Base.astro';
import Texture from '../components/Texture.astro';
import Well from '../components/Well.astro';
import Noise from '../components/Noise.astro';
import Spine from '../components/Spine.astro';
import { STORM_DOOR_URL } from '../consts';
---
<Base title="JS the WLD — Jonathan Sexton" nav="none" bare={true} motion={true}>
  <!-- ── HUD chrome: seal + corner consoles ── -->
  <a class="seal" href="/" aria-label="JS the WLD, home">
    <img src="/assets/bird-white.png" alt="" width="18" height="18" />
  </a>
  <a class="hud hud--tr" href={STORM_DOOR_URL} rel="noopener"><span>The Storm Door</span></a>
  <div class="hud hud--bl" aria-hidden="true"><span data-hud>Words / Music / Code</span></div>
  <div class="hud hud--br" aria-hidden="true"><span data-pct>00</span></div>
  <Spine stops={["Words", "Code", "Music", "Jonathan", "The Storm Door"]} />

  <main id="top">
    <!-- ══ 01 HERO — the ground falls away ══ -->
    <section class="hero" aria-label="JS the WLD">
      <Well />
      <Texture tone="dark" />

      <div class="hero__body">
        <!-- the mark in three pieces, cut at the seams where JS / THE / WLD
             interlock, so it can come apart and turn as you scroll -->
        <div class="mark" role="img" aria-label="JS the WLD">
          <span class="mark__pc mark__pc--js" aria-hidden="true"></span>
          <span class="mark__pc mark__pc--the" aria-hidden="true"></span>
          <span class="mark__pc mark__pc--wld" aria-hidden="true"></span>
        </div>

        <p class="hero__name"><span class="rv">I'm Jonathan Sexton aka JS the WLD.</span></p>

        <p class="hero__line"><span class="rv rv--2">I make stories with Words, Music, and Code.</span></p>
      </div>

      <a class="cue" href="#words" aria-label="Start"><span aria-hidden="true"></span></a>
    </section>

    <!-- ══ 02–04 THE TRIPTYCH — the three crafts run left to right ══ -->
    <section class="tri" id="words" data-tri aria-label="Words, Code and Music">
      <div class="tri__rail" data-tri-rail>

        <!-- WORDS -->
        <article class="panel panel--paper" id="code-anchor-words" data-hud="Words">
          <Texture tone="light" />
          <h2 class="panel__word panel__word--chroma" aria-hidden="true"><span data-t="WORDS">WORDS</span></h2>
          <div class="panel__body">
            <figure class="panel__fig">
              <img src="/assets/portrait.jpg" alt="Jonathan Sexton seated on a red couch, a lamp glowing beside him." width="1000" height="1500" loading="lazy" />
            </figure>
            <div class="panel__tell">
              <p class="tag">01 &mdash; The letter</p>
              <h3>The Storm Door</h3>
              <p>A letter most Saturday mornings. Life and how it's changing, music and technology, memories and old news.</p>
              <div class="panel__links">
                <a class="lnk" href={STORM_DOOR_URL} rel="noopener">Read the letter</a>
              </div>
            </div>
          </div>
        </article>

        <!-- CODE -->
        <article class="panel panel--wire" data-hud="Code">
          <div class="wire" aria-hidden="true"><span></span><span></span><span></span></div>
          <Texture tone="dark" />
          <h2 class="panel__word panel__word--lit panel__word--scramble" aria-hidden="true"><span data-final="CODE">CODE</span></h2>
          <div class="panel__body">
            <figure class="panel__fig is-wide">
              <img src="/assets/billy-bob-lightform.png" alt="Billy Bob, the light form — 302 nodes and 380 threads of American music history rendered as a constellation." width="1269" height="777" loading="lazy" />
            </figure>
            <div class="panel__tell">
              <p class="tag tag--lit">02 &mdash; Billy Bob</p>
              <h3 class="h3--lit">The living memory</h3>
              <p>A database of American music history you can fly through. Three hundred nodes, three hundred and eighty threads &mdash; every one a line of descent from somebody to somebody.</p>
              <div class="panel__links">
                <a class="lnk lnk--lit" href="/field/first-family/index.html">Open the river</a>
              </div>
            </div>
          </div>
        </article>

        <!-- MUSIC -->
        <article class="panel panel--dusk" data-hud="Music">
          <Texture tone="dark" />
          <h2 class="panel__word panel__word--anaglyph" aria-hidden="true"><span data-t="MUSIC">MUSIC</span></h2>
          <div class="panel__body">
            <figure class="panel__fig">
              <img src="/assets/interstitial.jpg" alt="" aria-hidden="true" width="1333" height="2000" loading="lazy" />
            </figure>
            <div class="panel__tell">
              <p class="tag">03 &mdash; Before the pages</p>
              <h3>The songs came first</h3>
              <p>A Bonnaroo stage, an O Music Award, and a Guinness World Record he's still a little embarrassed about. He still writes and fronts a band, because some things don't clock out.</p>
            </div>
          </div>
        </article>


        <!-- BOOK -->
        <article class="panel panel--book" data-hud="The Book">
          <Noise tone="#A8401D" />
          <h2 class="panel__word" aria-hidden="true"><span>THE BOOK</span></h2>
          <div class="panel__body panel__body--wide">
            <div class="panel__tell">
              <p class="tag">04 &mdash; Years in the making</p>
              <h3>The Sound of Something More</h3>
              <p>Where songs come from, where they go, and where they take us. Written under the mentorship of New York Times bestselling author Kathryn Aalto.</p>
              <div class="panel__links">
                <a class="lnk" href="/book">About the book</a>
              </div>
            </div>
          </div>
        </article>

      </div>
    </section>

    <!-- ══ 05 JONATHAN ══ -->
    <section class="act act--paper" id="jonathan" data-hud="Jonathan" aria-label="Jonathan Sexton">
      <Texture tone="light" />
      <h2 class="act__word act__word--r" aria-hidden="true"><span>SOUTH</span></h2>
      <div class="stage" data-stage>
        <figure class="grow grow--d">
          <img src="/assets/hero.jpg" alt="Jonathan Sexton at a wood-paneled bar in warm lamplight." width="1333" height="2000" loading="lazy" />
        </figure>
        <div class="tell">
          <p class="tag">05 &mdash; Who's back here</p>
          <h3>East Tennessee, by way of Nashville</h3>
          <p>Grew up up the road from where Dolly did. His dad handed him records and told him who played on them before he could read, and it mostly stuck.</p>
          <p>He taught school, built a few companies, worked in technology, and studied AI at MIT.</p>
          <a class="lnk" href="/about">More about Jonathan</a>
        </div>
      </div>
    </section>

    <!-- ══ 06 CLOSE ══ -->
    <section class="end" id="the-storm-door" data-hud="The Storm Door" aria-label="Subscribe">
      <Well variant="bed" />
      <Texture tone="dark" />
      <div class="end__body" data-stage>
        <figure class="grow grow--e end__art is-wide">
          <img src="/assets/storm-door/cover-banner-storm-lower-jswld-topright-1600x600.png" alt="The Storm Door" width="1600" height="600" loading="lazy" />
        </figure>
        <p class="tag tag--lit">Most Saturdays</p>
        <h2 class="end__word">THE STORM DOOR</h2>
        <p class="end__copy">Free, and short enough for one cup of coffee. Leave your name and I'll meet you there Saturday.</p>
        <a class="cta" href={STORM_DOOR_URL} rel="noopener">Read the letter</a>
      </div>
      <p class="colophon">JS the WLD &mdash; the pen name of Jonathan Sexton &mdash; East Tennessee, by way of Nashville</p>
    </section>
  </main>

  <script>
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // hero failsafe — animations throttle in hidden tabs; never ship a blank hero
    const hero = document.querySelector('.hero');
    const settle = () => hero && hero.classList.add('set');
    if (reduce) settle();
    else {
      setTimeout(settle, 3400);
      document.addEventListener('visibilitychange', () => { if (document.hidden) settle(); });
    }

    // ── Scroll-linked arrivals ──────────────────────────────────────────────
    // Every element carries `.in` as its END state. Under reduced motion (or if
    // the motion stack never boots) we simply add it and stop — the page is
    // fully composed with no tween ever registered. Otherwise ScrollTrigger
    // scrubs each element from its start transform to that end state, so motion
    // tracks the wheel in both directions instead of firing once and forgetting.
    const risers = [...document.querySelectorAll('[data-stage] > *, .act__word')];

    const composeStatically = () => risers.forEach((el) => el.classList.add('in'));

    const wireScrubbed = ({ gsap, ScrollTrigger }) => {
      // `.in` is applied up front so the element's *final* layout is what CSS
      // describes; GSAP then owns the transform/opacity between start and end.
      composeStatically();

      // Start transforms mirror the CSS intent, expressed as GSAP values so one
      // system owns the property. The CSS transition rules are gone (see <style>).
      const startFor = (el) => {
        if (el.classList.contains('slide')) {
          const far = el.classList.contains('slide--far');
          const dx = (el.classList.contains('slide--l') ? -1 : 1) * (far ? 160 : 90);
          return { x: dx, rotation: (dx < 0 ? -1 : 1) * (far ? 5 : 4), scale: far ? 0.92 : 1, opacity: 0 };
        }
        if (el.classList.contains('grow')) {
          const deep = el.classList.contains('grow--f');
          return { z: deep ? -780 : -520, scale: deep ? 0.3 : 0.42, opacity: 0 };
        }
        if (el.classList.contains('shout')) return { z: -420, opacity: 0 };
        if (el.classList.contains('act__word')) {
          const dir = el.classList.contains('act__word--r') ? 1 : -1;
          return { xPercent: 26 * dir, opacity: 0 };
        }
        return { y: 28, opacity: 0 }; // .tell and anything else in a stage
      };

      // ── Per-act signatures ──────────────────────────────────────────────
      // Each act gets its own window and scrub weight so the page reads as a
      // composed sequence rather than the same reveal five times. Heavier scrub
      // = more lag behind the wheel = a slower, weightier arrival.
      const SIGNATURES = [
        ['act--paper', { start: 'top 90%', end: 'top 46%', scrub: 0.9 }], // lateral, unhurried
        ['end', { start: 'top 92%', end: 'top 56%', scrub: 1.1 }], // settles
      ];
      const signatureFor = (el) => {
        for (const [cls, sig] of SIGNATURES) if (el.closest('.' + cls)) return sig;
        return { start: 'top 88%', end: 'top 42%', scrub: 0.6 };
      };


      const generic = risers;

      generic.forEach((el) => {
        // act words animate their inner span so the clipping wrapper stays put
        const node = el.classList.contains('act__word') ? el.querySelector('span') || el : el;
        const end = el.classList.contains('act__word')
          ? { xPercent: 0, opacity: 0.13 }
          : { x: 0, y: 0, z: 0, xPercent: 0, rotation: 0, scale: 1, opacity: 1 };
        const sig = signatureFor(el);

        gsap.fromTo(node, startFor(el), {
          ...end,
          ease: 'none',
          scrollTrigger: { trigger: el, start: sig.start, end: sig.end, scrub: sig.scrub },
        });
      });

      // ── Signature motions ───────────────────────────────────────────────
      // Each keys off what the thing *is*, rather than being another entrance.

      // 1. UNMASK. Photographs wipe open from their own frame instead of fading,
      //    so the plate reads as a shutter rather than a container.
      document.querySelectorAll('.stage figure img, .panel__fig img').forEach((img) => {
        gsap.fromTo(img,
          { clipPath: 'inset(0% 0% 100% 0%)' },
          { clipPath: 'inset(0% 0% 0% 0%)', ease: 'none',
            scrollTrigger: { trigger: img.closest('figure'), start: 'top 86%', end: 'top 50%', scrub: 0.5 } });
      });

      // 2. COUNTER-DRIFT. Copy rises slightly slower than its own section, so the
      //    two planes separate as you pass — depth from parallax, not shadow.
      document.querySelectorAll('.tell').forEach((tell) => {
        gsap.fromTo(tell, { yPercent: 6 }, { yPercent: -6, ease: 'none',
          scrollTrigger: { trigger: tell.closest('.stage') || tell, start: 'top bottom', end: 'bottom top', scrub: 1.2 } });
      });

      // 3. TRACKING OPEN. The act words widen their letterspacing as they arrive,
      //    so the type breathes instead of just sliding in.
      document.querySelectorAll('.act__word span, .panel__word span').forEach((sp) => {
        gsap.fromTo(sp, { letterSpacing: '-0.09em' }, { letterSpacing: '-0.035em', ease: 'none',
          scrollTrigger: { trigger: sp.closest('.act__word, .panel__word'), start: 'top 92%', end: 'top 45%', scrub: 0.8 } });
      });

      // 4. The seal turns with the page — a real readout of progress, not decor.
      const seal = document.querySelector('.seal img');
      if (seal) {
        gsap.to(seal, { rotation: 360, ease: 'none',
          scrollTrigger: { trigger: document.body, start: 'top top', end: 'bottom bottom', scrub: 1.4 } });
      }


      // ── THE TRIPTYCH: vertical scroll runs the three crafts sideways ─────
      const tri = document.querySelector('[data-tri]');
      const triRail = document.querySelector('[data-tri-rail]');
      if (tri && triRail && window.matchMedia('(min-width: 700px)').matches) {
        const travel = () => Math.max(0, triRail.scrollWidth - window.innerWidth);
        gsap.to(triRail, {
          x: () => -travel(),
          ease: 'none',
          scrollTrigger: {
            trigger: tri,
            start: 'top top',
            // TIGHT: 0.55 of the travel distance, so the sideways run costs far
            // less wheel than a 1:1 mapping. The reel at 1:1 read as a slog.
            end: () => '+=' + travel() * 0.55,
            pin: true,
            scrub: 0.8,
            invalidateOnRefresh: true,
            anticipatePin: 1,
          },
        });

        // each panel's content comes inward as its panel reaches the screen
        triRail.querySelectorAll('.panel').forEach((panel) => {
          gsap.fromTo(panel.querySelector('.panel__body'),
            { z: -220, opacity: 0.4 },
            { z: 0, opacity: 1, ease: 'none',
              scrollTrigger: {
                trigger: panel,
                containerAnimation: gsap.getTweensOf(triRail)[0],
                start: 'left 78%',
                end: 'center 60%',
                scrub: 0.5,
              } });
        });
      }


      // ── THE MARK: assembles on load, comes apart on scroll ───────────────
      const pieces = [...document.querySelectorAll('.mark__pc')];
      if (pieces.length) {
        // arrive: the three pieces fall in from apart and lock together
        gsap.from(pieces, {
          yPercent: (i) => [-70, 0, 70][i],
          xPercent: (i) => [-28, 34, -22][i],
          rotationZ: (i) => [-14, 11, -8][i],
          z: -420, opacity: 0,
          duration: 1.5, ease: 'expo.out', stagger: 0.11, delay: 0.25,
        });
        // depart: scrolling the hero pulls them apart again and turns them
        gsap.to(pieces, {
          yPercent: (i) => [-46, 0, 46][i],
          xPercent: (i) => [-30, 26, -18][i],
          rotationZ: (i) => [-13, 9, -7][i],
          rotationY: (i) => [18, -14, 12][i],
          z: (i) => [140, -60, 120][i],
          ease: 'none',
          scrollTrigger: { trigger: '.hero', start: 'top top', end: 'bottom top', scrub: 0.7 },
        });
      }

      // ── WORDS: chromatic aberration widens as the panel arrives ──────────
      const chroma = document.querySelector('.panel__word--chroma');
      if (chroma) {
        // WORDS is the FIRST panel, so its left edge is already past any
        // containerAnimation start at rail position 0 — that range is
        // degenerate and the tween sits permanently at its end value. Drive it
        // off the section's vertical approach instead, which is a live range.
        gsap.fromTo(chroma, { '--ab': '16px' }, { '--ab': '1px', ease: 'none',
          scrollTrigger: { trigger: tri, start: 'top 75%', end: 'top top', scrub: 0.6 } });
      }

      // ── MUSIC: anaglyph separation settles as it centres ─────────────────
      const ana = document.querySelector('.panel__word--anaglyph');
      if (ana) {
        gsap.fromTo(ana, { '--eye': '22px' }, { '--eye': '4px', ease: 'none',
          scrollTrigger: { trigger: ana.closest('.panel'),
            containerAnimation: gsap.getTweensOf(triRail)[0],
            start: 'left 85%', end: 'center 60%', scrub: 0.5 } });
      }

      // ── CODE: the word scrambles, then resolves ──────────────────────────
      const scr = document.querySelector('.panel__word--scramble span');
      if (scr) {
        const FINAL = scr.dataset.final || scr.textContent;
        const GLYPHS = '01<>[]{}/\\#$%&*+=~^ABCDEFGHIJKLMNOPQRSTUVWXYZ';
        let raf = 0;
        const run = () => {
          cancelAnimationFrame(raf);
          const start = performance.now();
          const DUR = 900;
          const tick = (now) => {
            const t = Math.min(1, (now - start) / DUR);
            // characters resolve left to right
            const settled = Math.floor(t * FINAL.length * 1.35);
            let out = '';
            for (let i = 0; i < FINAL.length; i++) {
              out += i < settled ? FINAL[i] : GLYPHS[(Math.random() * GLYPHS.length) | 0];
            }
            scr.textContent = out;
            if (t < 1) raf = requestAnimationFrame(tick);
            else scr.textContent = FINAL;
          };
          raf = requestAnimationFrame(tick);
        };
        ScrollTrigger.create({
          trigger: scr.closest('.panel'),
          containerAnimation: gsap.getTweensOf(triRail)[0],
          start: 'left 70%',
          onEnter: run, onEnterBack: run,
        });
      }

      ScrollTrigger.refresh();
    };

    if (reduce) composeStatically();
    else if (window.__motion && !window.__motion.reduce) wireScrubbed(window.__motion);
    else {
      // Motion stack still booting — attach when it signals, but never leave the
      // page blank if it fails to arrive at all.
      let wired = false;
      addEventListener('motion:ready', (e) => {
        if (wired) return;
        wired = true;
        e.detail && !e.detail.reduce ? wireScrubbed(e.detail) : composeStatically();
      }, { once: true });
      setTimeout(() => { if (!wired) { wired = true; composeStatically(); } }, 2500);
    }

    // scroll: HUD readout, percent, texture parallax, hero deck recede
    const hud = document.querySelector('[data-hud]');
    const pct = document.querySelector('[data-pct]');
    const marks = [...document.querySelectorAll('[data-hud]')].filter((m) => m.dataset.hud);
    const layers = reduce ? [] : [...document.querySelectorAll('[data-par]')];
    let tick = false;
    const draw = () => {
      tick = false;
      const sy = window.scrollY;
      const doc = document.body.scrollHeight - window.innerHeight;
      const p = Math.min(1, Math.max(0, sy / (doc || 1)));
      if (pct) pct.textContent = String(Math.round(p * 100)).padStart(2, '0');
      const mid = sy + window.innerHeight * 0.5;
      let cur = null;
      for (const m of marks) if (m.offsetTop <= mid) cur = m.dataset.hud;
      if (hud && cur && hud.textContent !== cur) hud.textContent = cur;
      for (const l of layers) {
        const host = l.parentElement.parentElement;
        l.style.transform = `translate3d(0,${((sy - host.offsetTop) * parseFloat(l.dataset.par)).toFixed(1)}px,0)`;
      }
    };
    addEventListener('scroll', () => { if (!tick) { tick = true; requestAnimationFrame(draw); } }, { passive: true });
    draw();
  </script>
</Base>

<style>
  /* ══════ TYPE: matte grotesque + typewriter. No serif. ══════ */
  main{--grot:"Archivo",ui-sans-serif,system-ui,sans-serif;
    --tw:"Courier Prime",ui-monospace,"SF Mono",monospace;
    --wire-bg:#04060B; --lit:#40C4E8; --edge:rgba(64,196,232,.18); --edge-lit:rgba(64,196,232,.85);
    --paper:#EDEAE3; --dusk:#171512; --ink:#1B1916}

  /* ══════ HUD chrome ══════ */
  .seal{position:fixed; top:14px; left:14px; z-index:99; width:38px; height:38px; border-radius:50%;
    background:rgba(0,0,0,.62); display:grid; place-items:center;
    box-shadow:0 0 0 1px rgba(255,255,255,.22), 0 2px 12px rgba(0,0,0,.6);
    transition:box-shadow 900ms cubic-bezier(.2,.8,.2,1)}
  .seal:hover{box-shadow:0 0 0 1px var(--edge-lit), 0 0 22px rgba(64,196,232,.5)}
  .seal img{width:18px; height:auto}
  .hud{position:fixed; z-index:99; padding:7px 11px; text-decoration:none;
    background:rgba(8,10,14,.55); -webkit-backdrop-filter:blur(8px); backdrop-filter:blur(8px);
    box-shadow:inset 0 0 0 1px rgba(255,255,255,.16)}
  .hud span{font-family:var(--tw); font-size:10px; letter-spacing:.18em; text-transform:uppercase;
    color:#EAF2F6; white-space:nowrap}
  .hud--tr{top:14px; right:14px}
  .hud--tr:hover{box-shadow:inset 0 0 0 1px var(--edge-lit)}
  .hud--bl{bottom:14px; left:14px; pointer-events:none}
  .hud--br{bottom:14px; right:14px; pointer-events:none}
  .hud--br span{color:var(--lit)}
  @media(max-width:640px){.hud--bl{display:none}}

  /* ══════ 01 HERO — perspective, the ground falls away ══════ */
  .hero{position:relative; min-height:100svh; display:grid; place-items:center; overflow:hidden;
    background:#04060B; color:#E9E4D8; padding:9vh 5vw 11vh}


  .hero__body{position:relative; z-index:3; text-align:center; max-width:70ch;
    transform-style:preserve-3d; padding:clamp(1.5rem,4vw,3rem) clamp(1.5rem,5vw,4rem)}
  /* the streams run behind the text, so the copy gets its own bed of dark */
  .hero__body::before{content:""; position:absolute; inset:-6% -8%; z-index:-1; border-radius:50%;
    background:radial-gradient(62% 58% at 50% 50%, rgba(4,6,11,.82) 0%, rgba(4,6,11,.5) 62%, transparent 84%)}

  /* ══════ THE MARK, EXPLODED ══════
     One image, three clipped copies. Bands overlap slightly at the seams
     (measured from the artwork's own ink coverage: JS/THE break ~33%,
     THE/WLD ~61%) so the pieces read as having come apart rather than
     been sliced. */
  .mark{position:relative; width:clamp(112px,15vw,205px); aspect-ratio:969/1200;
    margin:0 auto clamp(1.1rem,2.4vw,1.7rem); transform-style:preserve-3d}
  .mark__pc{position:absolute; inset:0; display:block;
    background:url('/assets/jswld-wordmark.png') center/contain no-repeat;
    filter:drop-shadow(0 18px 34px rgba(0,0,0,.55)); will-change:transform}
  .mark__pc--js{clip-path:inset(0 0 64% 0)}
  .mark__pc--the{clip-path:inset(30% 0 37% 0)}
  .mark__pc--wld{clip-path:inset(58% 0 0 0)}

  /* pieces fly together on load... */
  :global(.js) .mark__pc{opacity:0}
  :global(.js) .hero.set .mark__pc{opacity:1}

  .rv{display:inline-block}
  :global(.js) .rv{clip-path:inset(0 100% 0 0); opacity:0;
    animation:rvIn 1000ms cubic-bezier(.16,1,.3,1) 1200ms forwards}
  :global(.js) .rv--2{animation-delay:1650ms}
  :global(.js) .rv--3{animation-delay:3000ms}
  @keyframes rvIn{to{clip-path:inset(0 0 0 0); opacity:1}}

  .hero__name{font-family:var(--tw); font-size:clamp(.72rem,1.5vw,.86rem); letter-spacing:.2em;
    text-transform:uppercase; color:#9FB0B8; margin:0 0 clamp(.7rem,1.6vw,1.1rem)}

  /* the maker line — one sentence, small, the three crafts carrying the color */
  .hero__line{font-family:var(--tw); font-size:clamp(.9rem,1.9vw,1.14rem); line-height:1.75;
    letter-spacing:.02em; color:#C9D3D8; margin:0 0 clamp(1.4rem,3vw,2rem)}
  .hero__line{color:#EDE9DF}

  .hero__tail{font-family:var(--tw); font-size:clamp(.82rem,1.5vw,.98rem); line-height:1.85;
    color:#8C9BA3; max-width:54ch; margin:0 auto}

  .cue{position:absolute; left:50%; bottom:26px; translate:-50% 0; width:1px; height:44px; z-index:4}
  .cue span{display:block; width:1px; height:100%;
    background:linear-gradient(180deg, transparent, var(--lit), transparent);
