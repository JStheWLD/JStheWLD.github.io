---
// THE HARP — the strands in the hero sound when the cursor crosses them.
//
// Karplus-Strong plucked string: a burst of noise fed through a delay line with
// a lowpass in the feedback loop. The delay length sets the pitch and the
// filter kills the harmonics over time, which is why it decays like a real
// string instead of a beep.
//
// Sound never starts on its own. Browsers require a gesture to unlock audio,
// and unannounced sound is hostile, so the toggle IS the unlock and the state
// is remembered.
---
<canvas class="motes" data-motes aria-hidden="true"></canvas>
<button class="harp" data-harp type="button" aria-pressed="false"
  aria-label="Play the strands">
  <span class="harp__wave" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
  <span class="harp__txt">Sound</span>
</button>

<script>
  const btn = document.querySelector('[data-harp]');
  if (btn) {
    const KEY = 'jswld:harp';
    let ctx = null, bus = null, on = false;
    let last = -1, lastAt = 0;

    // Tuned to G — the key Free Bird lives in — using G major with the flat-7
    // (F natural) that gives Southern rock its modal colour, i.e. G mixolydian.
    // This is a KEY and a MODE, not the song: no melody is encoded here. Any
    // two strands struck together still sit inside that harmony.
    //   G  A  B  C  D  E  F   across two octaves, low G to high G
    const HZ = [
      196.00, // G3
      220.00, // A3
      246.94, // B3
      261.63, // C4
      293.66, // D4
      329.63, // E4
      349.23, // F4   <- the flat-7
      392.00, // G4
      440.00, // A4
      493.88, // B4
      523.25, // C5
      587.33, // D5
      659.25, // E5
      698.46, // F5
      783.99, // G5
    ];

    const build = () => {
      const AC = window.AudioContext || window.webkitAudioContext;
      if (!AC) return false;
      ctx = new AC();
      bus = ctx.createGain();
      bus.gain.value = 0.12;                 // quiet by design
      const room = ctx.createConvolver();     // a little air around the note
      const len = ctx.sampleRate * 1.4;
      const imp = ctx.createBuffer(2, len, ctx.sampleRate);
      for (let c = 0; c < 2; c++) {
        const d = imp.getChannelData(c);
        for (let i = 0; i < len; i++) d[i] = (Math.random() * 2 - 1) * Math.pow(1 - i / len, 3.2);
      }
      room.buffer = imp;
      const wet = ctx.createGain(); wet.gain.value = 0.28;
      bus.connect(ctx.destination);
      bus.connect(room); room.connect(wet); wet.connect(ctx.destination);
      return true;
    };

    // one plucked string. The options exist so a second, lower voice elsewhere
    // on the page can sound like a bigger string rather than a transposed small
    // one: longer to die away, and darker, because a thick string loses its
    // harmonics faster than a thin one.
    const pluck = (hz, opt) => {
      if (!ctx || ctx.state !== 'running') return;
      const { gain = 1, tone: cutoff = 2600, seconds = 2.2, decay = 0.996 } = opt || {};
      const N = Math.max(2, Math.round(ctx.sampleRate / hz));
      const buf = ctx.createBuffer(1, Math.ceil(ctx.sampleRate * seconds), ctx.sampleRate);
      const d = buf.getChannelData(0);
      // excite with noise, then run the Karplus-Strong loop in place
      for (let i = 0; i < N; i++) d[i] = Math.random() * 2 - 1;
      for (let i = N; i < d.length; i++) d[i] = (d[i - N] + d[i - N + 1]) * 0.5 * decay;
      // taper the tail so it never clicks off
      const tail = Math.floor(d.length * 0.35);
      for (let i = d.length - tail; i < d.length; i++) {
        d[i] *= (d.length - i) / tail;
      }
      const src = ctx.createBufferSource(); src.buffer = buf;
      const g = ctx.createGain();
      g.gain.value = (0.9 + Math.random() * 0.2) * gain;
      const tone = ctx.createBiquadFilter();
      tone.type = 'lowpass'; tone.frequency.value = cutoff;
      src.connect(tone); tone.connect(g); g.connect(bus);
      src.start();
      src.stop(ctx.currentTime + seconds);
    };

    // ── THE INSTRUMENT, SHARED ──────────────────────────────────────────
    // Other surfaces play through this rather than standing up their own audio.
    // One AudioContext, one unlock gesture, one toggle: the page is a single
    // instrument that happens to have more than one set of strings. A second
    // context would also mean a second unlock, which the reader never agreed to.
    window.__harp = {
      pluck: (hz, opt) => { if (on) pluck(hz, opt); },
      get on() { return on; },
    };

    // ── MOTES: a note draws a few sparks out of the strand ──────────────
    // Pied piper: they are summoned by the sound, then follow the cursor as it
    // moves away. Deliberately few — a handful per note, hard-capped, so the
    // hero never turns into a snow globe.
    const mc = document.querySelector('[data-motes]');
    const mx = mc && mc.getContext('2d');
    const motes = [];
    const CAP = 46;
    let px = 0, py = 0, mraf = 0, mrunning = false;
    const reduceMo = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const sizeMotes = () => {
      if (!mc) return;
      const dpr = Math.min(2, window.devicePixelRatio || 1);
      mc.width = Math.round(mc.clientWidth * dpr);
      mc.height = Math.round(mc.clientHeight * dpr);
      mx.setTransform(dpr, 0, 0, dpr, 0, 0);
    };

    // higher notes throw brighter, lighter sparks
    const summon = (x, y, hz) => {
      if (!mc || reduceMo) return;
      const lift = Math.min(1, (hz - 196) / 588);
      const n = 3 + Math.round(Math.random() * 2);
      for (let i = 0; i < n; i++) {
        if (motes.length >= CAP) motes.shift();
        motes.push({
          x, y,
          vx: (Math.random() - 0.5) * 0.7,
          vy: -0.25 - Math.random() * 0.6 - lift * 0.5,
          life: 1,
          decay: 0.0055 + Math.random() * 0.004,
          r: 0.9 + Math.random() * 1.5 + lift,
          hue: lift,
        });
      }
      startMotes();
    };

    const stepMotes = () => {
      const w = mc.clientWidth, h = mc.clientHeight;
      mx.clearRect(0, 0, w, h);
      for (let i = motes.length - 1; i >= 0; i--) {
        const m = motes[i];
        // the piper: drift toward wherever the pointer went
        const dx = px - m.x, dy = py - m.y;
        const d = Math.hypot(dx, dy) || 1;
        // inverse-LINEAR, not inverse-square: at a few hundred px an
        // inverse-square pull is ~0.00003, so the motes ignored the pointer
        // entirely and just floated. This actually follows.
        const pull = Math.min(0.05, 18 / (d + 80));
        m.vx += (dx / d) * pull;
        m.vy += (dy / d) * pull - 0.004;    // and a little buoyancy
        m.vx *= 0.985; m.vy *= 0.985;
        m.x += m.vx; m.y += m.vy;
        m.life -= m.decay;
        if (m.life <= 0) { motes.splice(i, 1); continue; }
        const a = Math.pow(m.life, 1.6);
        // amber for the low strings, cyan for the high ones
        const c = m.hue > 0.55 ? '64,196,232' : '217,154,66';
        mx.beginPath();
        mx.arc(m.x, m.y, m.r * (0.5 + m.life * 0.7), 0, 6.2832);
        mx.fillStyle = `rgba(${c},${(a * 0.85).toFixed(3)})`;
        mx.fill();
      }
      if (motes.length) mraf = requestAnimationFrame(stepMotes);
      else { mrunning = false; mx.clearRect(0, 0, w, h); }
    };
    const startMotes = () => { if (!mrunning && !reduceMo) { mrunning = true; mraf = requestAnimationFrame(stepMotes); } };

    sizeMotes();
    addEventListener('resize', sizeMotes, { passive: true });
    document.addEventListener('visibilitychange', () => {
      if (document.hidden) { cancelAnimationFrame(mraf); mrunning = false; motes.length = 0; }
    });

    // the hero's strands are a canvas, so pitch comes from where the pointer is
    const hero = document.querySelector('.hero');
    const onMove = (e) => {
      if (!on || !hero) return;
      const r = hero.getBoundingClientRect();
      if (e.clientY < r.top || e.clientY > r.bottom) return;
      const x = (e.clientX - r.left) / r.width;
      const i = Math.min(HZ.length - 1, Math.max(0, Math.round(x * (HZ.length - 1))));
      const now = performance.now();
      // only when crossing into a NEW string, and never faster than a hand could
      if (i === last || now - lastAt < 70) return;
      last = i; lastAt = now;
      px = e.clientX - r.left; py = e.clientY - r.top;
      pluck(HZ[i]);
      summon(px, py, HZ[i]);
    };

    const setOn = (v) => {
      on = v;
      btn.setAttribute('aria-pressed', String(v));
      btn.classList.toggle('is-on', v);
      try { localStorage.setItem(KEY, v ? '1' : '0'); } catch {}
      if (v && ctx && ctx.state === 'suspended') ctx.resume();
    };

    btn.addEventListener('click', () => {
      if (!ctx && !build()) return;       // no Web Audio: leave the button inert
      if (!on) ctx.resume();              // this click is the unlock gesture
      setOn(!on);
      if (on) {
        pluck(HZ[7]);                     // confirm on the tonic
        if (hero) { const r = hero.getBoundingClientRect(); summon(r.width / 2, r.height * 0.62, HZ[7]); }
      }
    });

    addEventListener('pointermove', onMove, { passive: true });
    // returning visitors who had it on still need a gesture, so stay off and
    // just remember the preference for the button's own state.
    try { if (localStorage.getItem(KEY) === '1') btn.classList.add('was-on'); } catch {}
  }
</script>

<style>
  .motes{position:fixed; inset:0; width:100%; height:100%; display:block;
    z-index:96; pointer-events:none}
  .harp{position:fixed; bottom:14px; left:50%; translate:-50% 0; z-index:99;
    display:flex; align-items:center; gap:9px; cursor:pointer;
    padding:7px 13px; border:0;
    background:rgba(8,10,14,.55); -webkit-backdrop-filter:blur(8px); backdrop-filter:blur(8px);
    box-shadow:inset 0 0 0 1px rgba(255,255,255,.16);
    transition:box-shadow 600ms ease}
  .harp:hover, .harp.is-on{box-shadow:inset 0 0 0 1px rgba(64,196,232,.85)}
  .harp__txt{font-family:"Courier Prime",ui-monospace,monospace; font-size:10px;
    letter-spacing:.2em; text-transform:uppercase; color:#EAF2F6}
  .harp.is-on .harp__txt{color:#40C4E8}
  .harp__wave{display:flex; align-items:center; gap:2px; height:12px}
  .harp__wave i{display:block; width:2px; height:3px; background:#EAF2F6; opacity:.6}
  .harp.is-on .harp__wave i{background:#40C4E8; opacity:1; animation:harpWave 1.1s ease-in-out infinite}
  .harp.is-on .harp__wave i:nth-child(2){animation-delay:.14s}
  .harp.is-on .harp__wave i:nth-child(3){animation-delay:.28s}
  .harp.is-on .harp__wave i:nth-child(4){animation-delay:.42s}
  @keyframes harpWave{0%,100%{height:3px} 50%{height:12px}}
  @media (prefers-reduced-motion:reduce){ .harp.is-on .harp__wave i{animation:none; height:7px} }
  @media(max-width:620px){ .harp{display:none} }
</style>
