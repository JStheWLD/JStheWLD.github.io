---
// THE HARP — the strands in the hero sound when the cursor crosses them.
//
// Karplus-Strong plucked string: a burst of noise fed through a delay line with
// a lowpass in the feedback loop. The delay length sets the pitch and the
// filter kills the harmonics over time, which is why it decays like a real
// string instead of a beep.
//
// Sound never starts on its own. Browsers require a gesture to unlock audio,
// and unannounced sound is hostile, so the toggle IS the unlock and the state
// is remembered.
---
<button class="harp" data-harp type="button" aria-pressed="false"
  aria-label="Play the strands">
  <span class="harp__wave" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
  <span class="harp__txt">Sound</span>
</button>

<script>
  const btn = document.querySelector('[data-harp]');
  if (btn) {
    const KEY = 'jswld:harp';
    let ctx = null, bus = null, on = false;
    let last = -1, lastAt = 0;

    // A minor pentatonic across two octaves — no semitone clashes, so any two
    // strands struck together still sound intentional.
    const HZ = [220.0, 261.6, 293.7, 349.2, 392.0,
                440.0, 523.3, 587.3, 698.5, 784.0, 880.0];

    const build = () => {
      const AC = window.AudioContext || window.webkitAudioContext;
      if (!AC) return false;
      ctx = new AC();
      bus = ctx.createGain();
      bus.gain.value = 0.12;                 // quiet by design
      const room = ctx.createConvolver();     // a little air around the note
      const len = ctx.sampleRate * 1.4;
      const imp = ctx.createBuffer(2, len, ctx.sampleRate);
      for (let c = 0; c < 2; c++) {
        const d = imp.getChannelData(c);
        for (let i = 0; i < len; i++) d[i] = (Math.random() * 2 - 1) * Math.pow(1 - i / len, 3.2);
      }
      room.buffer = imp;
      const wet = ctx.createGain(); wet.gain.value = 0.28;
      bus.connect(ctx.destination);
      bus.connect(room); room.connect(wet); wet.connect(ctx.destination);
      return true;
    };

    // one plucked string
    const pluck = (hz) => {
      if (!ctx || ctx.state !== 'running') return;
      const N = Math.max(2, Math.round(ctx.sampleRate / hz));
      const seconds = 2.2;
      const buf = ctx.createBuffer(1, Math.ceil(ctx.sampleRate * seconds), ctx.sampleRate);
      const d = buf.getChannelData(0);
      // excite with noise, then run the Karplus-Strong loop in place
      for (let i = 0; i < N; i++) d[i] = Math.random() * 2 - 1;
      const decay = 0.996;
      for (let i = N; i < d.length; i++) d[i] = (d[i - N] + d[i - N + 1]) * 0.5 * decay;
      // taper the tail so it never clicks off
      const tail = Math.floor(d.length * 0.35);
      for (let i = d.length - tail; i < d.length; i++) {
        d[i] *= (d.length - i) / tail;
      }
      const src = ctx.createBufferSource(); src.buffer = buf;
      const g = ctx.createGain();
      g.gain.value = 0.9 + Math.random() * 0.2;
      const tone = ctx.createBiquadFilter();
      tone.type = 'lowpass'; tone.frequency.value = 2600;
      src.connect(tone); tone.connect(g); g.connect(bus);
      src.start();
      src.stop(ctx.currentTime + seconds);
    };

    // the hero's strands are a canvas, so pitch comes from where the pointer is
    const hero = document.querySelector('.hero');
    const onMove = (e) => {
      if (!on || !hero) return;
      const r = hero.getBoundingClientRect();
      if (e.clientY < r.top || e.clientY > r.bottom) return;
      const x = (e.clientX - r.left) / r.width;
      const i = Math.min(HZ.length - 1, Math.max(0, Math.round(x * (HZ.length - 1))));
      const now = performance.now();
      // only when crossing into a NEW string, and never faster than a hand could
      if (i === last || now - lastAt < 70) return;
      last = i; lastAt = now;
      pluck(HZ[i]);
    };

    const setOn = (v) => {
      on = v;
      btn.setAttribute('aria-pressed', String(v));
      btn.classList.toggle('is-on', v);
      try { localStorage.setItem(KEY, v ? '1' : '0'); } catch {}
      if (v && ctx && ctx.state === 'suspended') ctx.resume();
    };

    btn.addEventListener('click', () => {
      if (!ctx && !build()) return;       // no Web Audio: leave the button inert
      if (!on) ctx.resume();              // this click is the unlock gesture
      setOn(!on);
      if (on) pluck(HZ[5]);               // confirm with a single note
    });

    addEventListener('pointermove', onMove, { passive: true });
    // returning visitors who had it on still need a gesture, so stay off and
    // just remember the preference for the button's own state.
    try { if (localStorage.getItem(KEY) === '1') btn.classList.add('was-on'); } catch {}
  }
</script>

<style>
  .harp{position:fixed; bottom:14px; left:50%; translate:-50% 0; z-index:99;
    display:flex; align-items:center; gap:9px; cursor:pointer;
    padding:7px 13px; border:0;
    background:rgba(8,10,14,.55); -webkit-backdrop-filter:blur(8px); backdrop-filter:blur(8px);
    box-shadow:inset 0 0 0 1px rgba(255,255,255,.16);
    transition:box-shadow 600ms ease}
  .harp:hover, .harp.is-on{box-shadow:inset 0 0 0 1px rgba(64,196,232,.85)}
  .harp__txt{font-family:"Courier Prime",ui-monospace,monospace; font-size:10px;
    letter-spacing:.2em; text-transform:uppercase; color:#EAF2F6}
  .harp.is-on .harp__txt{color:#40C4E8}
  .harp__wave{display:flex; align-items:center; gap:2px; height:12px}
  .harp__wave i{display:block; width:2px; height:3px; background:#EAF2F6; opacity:.6}
  .harp.is-on .harp__wave i{background:#40C4E8; opacity:1; animation:harpWave 1.1s ease-in-out infinite}
  .harp.is-on .harp__wave i:nth-child(2){animation-delay:.14s}
  .harp.is-on .harp__wave i:nth-child(3){animation-delay:.28s}
  .harp.is-on .harp__wave i:nth-child(4){animation-delay:.42s}
  @keyframes harpWave{0%,100%{height:3px} 50%{height:12px}}
  @media (prefers-reduced-motion:reduce){ .harp.is-on .harp__wave i{animation:none; height:7px} }
  @media(max-width:620px){ .harp{display:none} }
</style>
